  errorGLES10notSupported()
}

// ----------------------------------------------------------------------------
// extensions for the framework
// ----------------------------------------------------------------------------

cmd void glColorPointerBounds(GLint size, GLenum type, GLsizei stride, const void* pointer, GLsizei count) {
  minRequiredVersion(1, 0)
  errorGLES10notSupported()
}

cmd void glNormalPointerBounds(GLenum type, GLsizei stride, const void* pointer, GLsizei count) {
  minRequiredVersion(1, 0)
  errorGLES10notSupported()
}

cmd void glTexCoordPointerBounds(GLint size, GLenum type, GLsizei stride, const void* pointer, GLsizei count) {
  minRequiredVersion(1, 0)
  errorGLES10notSupported()
}

cmd void glVertexPointerBounds(GLint size, GLenum type, GLsizei stride, const void* pointer, GLsizei count) {
  minRequiredVersion(1, 0)
  errorGLES10notSupported()
}

cmd void glPointSizePointerOESBounds(GLenum type, GLsizei stride, const void* pointer, GLsizei count) {
