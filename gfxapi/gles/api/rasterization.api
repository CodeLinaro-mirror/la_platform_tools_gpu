cmd void glGetMultisamplefv(GLenum pname, GLuint index, GLfloat* val) {
  minRequiredVersion(3, 1)
  switch (pname) {
    case GL_SAMPLE_POSITION: {
      // version 3.1
    }
    default: {
      glErrorInvalidEnum(pname)
    }
  }
