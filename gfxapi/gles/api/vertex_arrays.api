// TODO: Many variables have names like vao2 as a workaround for colliding
//       local names.  Rename them back once we fix the naming issue.

@internal
enum Constants {
  MAX_VERTEX_ATTRIBS                = 16  ,
  MAX_VERTEX_ATTRIB_BINDINGS        = 16  ,
  MAX_VERTEX_ATTRIB_STRIDE          = 2048,
  MAX_VERTEX_ATTRIB_RELATIVE_OFFSET = 2047
}

type GLuint BindingIndex
type GLuint AttributeLocation

// Vertex Array Object (VAO)
@internal
class VertexArray {
  map!(BindingIndex, ref!VertexBufferBinding)       VertexBufferBindings
  map!(AttributeLocation, ref!VertexAttributeArray) VertexAttributeArrays
}

@internal
class VertexBufferBinding {
  BufferId Buffer
  GLintptr Offset  = 0
  GLsizei  Stride  = 16
  GLuint   Divisor = 0  // Non-zero values enable instancing.
}

@internal
class VertexAttributeArray {
  bool          Enabled        = false
  GLint         Size           = 4        // Number of components. 1, 2, 3 or 4.
  GLenum        Type           = GL_FLOAT // Type of each component.
  GLboolean     Normalized     = 0
  GLsizei       Stride         = 0        // Obsolete/incorrect. See VertexBufferBinding stride instead.
  VertexPointer Pointer                   // Client's data if BoundVertexArray == 0 && Buffer == 0
  GLuint        RelativeOffset = 0
  bool          Integer        = false    // Do not convert to float - the shader uses integer type.
  BindingIndex  Binding                   // Index of VertexBufferBinding.
}

@internal
class VertexAttributeValue {
  u8[] Value // Used if VertexAttributeArray is disabled.
}

macro ref!VertexArray NewVertexArray() {
  array := new!VertexArray()
  for i in (0 .. as!BindingIndex(MAX_VERTEX_ATTRIB_BINDINGS)) {
    array.VertexBufferBindings[i] = new!VertexBufferBinding()
  }
  for i in (0 .. as!AttributeLocation(MAX_VERTEX_ATTRIBS)) {
    array.VertexAttributeArrays[i] = new!VertexAttributeArray(Binding: as!BindingIndex(i))
  }
  return array
}

// Logic shared by glGetVertexAttrib* commands.
macro u64 GetVertexAttrib(ref!Context ctx, AttributeLocation index, GLenum pname) {
  vao2 := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  array := vao2.VertexAttributeArrays[index]
  // TODO: Uncomment all the version checks
  return switch (pname) {
    case GL_VERTEX_ATTRIB_ARRAY_ENABLED:        { as!u64(array.Enabled) }
    case GL_VERTEX_ATTRIB_ARRAY_SIZE:           { as!u64(array.Size) }
    case GL_VERTEX_ATTRIB_ARRAY_TYPE:           { as!u64(array.Type) }
    case GL_VERTEX_ATTRIB_ARRAY_NORMALIZED:     { as!u64(array.Normalized) }
    case GL_VERTEX_ATTRIB_ARRAY_STRIDE:         { as!u64(array.Stride) }
    case GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING: {
      as!u64(vao2.VertexBufferBindings[array.Binding].Buffer)
    }
    case GL_VERTEX_ATTRIB_ARRAY_DIVISOR: {
      // minRequiredVersion(3, 0)
      as!u64(vao2.VertexBufferBindings[array.Binding].Divisor)
    }
    case GL_VERTEX_ATTRIB_ARRAY_INTEGER: {
      // minRequiredVersion(3, 0)
      as!u64(array.Integer)
    }
    case GL_VERTEX_ATTRIB_BINDING: {
      // minRequiredVersion(3, 1)
      as!u64(array.Binding)
    }
    case GL_VERTEX_ATTRIB_RELATIVE_OFFSET: {  // SPEC: missing in html
      // minRequiredVersion(3, 1)
      as!u64(array.RelativeOffset)
    }
    default: {
      // glErrorInvalidEnum(pname)
      0
    }
  }
}

macro GLint VertexAttribTypeSize(GLenum type) {
  return switch (type) {
    case GL_BYTE, GL_UNSIGNED_BYTE:                                     1
    case GL_SHORT, GL_UNSIGNED_SHORT, GL_HALF_FLOAT, GL_HALF_FLOAT_OES: 2
    case GL_INT, GL_UNSIGNED_INT, GL_FLOAT, GL_FIXED:                   4
    case GL_INT_2_10_10_10_REV, GL_UNSIGNED_INT_2_10_10_10_REV:         4
  }
}

macro void ReadVertexArrays(ref!Context ctx, u32 first_index, u32 index_count, u32 instance_count) {
  if (index_count > 0) && (instance_count > 0) {
    // Only the default vertex array can contain client data pointer.
    if ctx.BoundVertexArray == 0 {
      vao3 := ctx.Instances.VertexArrays[0]
      for i in (0 .. as!AttributeLocation(MAX_VERTEX_ATTRIBS)) {
        arr := vao3.VertexAttributeArrays[i]
        if arr.Enabled {
          binding := vao3.VertexBufferBindings[arr.Binding]
          if (binding.Buffer == 0) && (arr.Pointer != null) {
            stride := binding.Stride
            size := VertexAttribTypeSize(arr.Type) * arr.Size
            divisor := as!u32(binding.Divisor)
            if divisor == 0 {
              for v in (first_index .. (first_index + index_count)) {
                offset := as!GLint(stride) * as!GLint(v)
                read(arr.Pointer[offset:offset + size])
              }
            } else {
              last_instance := instance_count - 1
              last_index := last_instance / divisor
              // First index is not added to instanced arrays.
              for v in (0 .. (last_index + 1)) {
                offset := as!GLint(stride) * as!GLint(v)
                read(arr.Pointer[offset:offset + size])
              }
            }
          }
        }
      }
    }
  }
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glBindVertexArray.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glBindVertexArray.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glBindVertexArray.xhtml","OpenGL ES 3.2")
cmd void glBindVertexArray(VertexArrayId array) {
  minRequiredVersion(3, 0)
  ctx := GetContext()
  // TODO: glErrorInvalidOperationIf(!((array == 0) || (array in ctx.UsedNames.VertexArrays)))
  if !(array in ctx.Instances.VertexArrays) {
    ctx.Instances.VertexArrays[array] = NewVertexArray()
  }
  ctx.BoundVertexArray = array
}

macro void BindVertexBuffer(ref!Context ctx, BindingIndex binding_index, BufferId buffer, GLintptr offset, GLsizei stride) {
  glErrorInvalidValueIf(binding_index >= as!BindingIndex(MAX_VERTEX_ATTRIB_BINDINGS))
  glErrorInvalidValueIf(offset < 0)
  glErrorInvalidValueIf(stride < 0)
  glErrorInvalidValueIf(stride > as!GLsizei(MAX_VERTEX_ATTRIB_STRIDE))
  // TODO: glErrorInvalidOperationIf(!((buffer == 0) || (buffer in ctx.UsedNames.Buffers))) // SPEC: html is different
  if !(buffer in ctx.Instances.Buffers) {
    ctx.Instances.Buffers[buffer] = new!Buffer()
  }
  vao4 := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  binding := vao4.VertexBufferBindings[binding_index]
  binding.Buffer = buffer
  binding.Offset = offset
  binding.Stride = stride
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glBindVertexBuffer.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glBindVertexBuffer.xhtml","OpenGL ES 3.2")
cmd void glBindVertexBuffer(BindingIndex binding_index, BufferId buffer, GLintptr offset, GLsizei stride) {
  minRequiredVersion(3, 1)
  ctx := GetContext()
  glErrorInvalidOperationIf(ctx.BoundVertexArray == 0)
  BindVertexBuffer(ctx, binding_index, buffer, offset, stride)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glDeleteVertexArrays.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glDeleteVertexArrays.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glDeleteVertexArrays.xhtml","OpenGL ES 3.2")
cmd void glDeleteVertexArrays(GLsizei count, const VertexArrayId* arrays) {
  minRequiredVersion(3, 0)
  glErrorInvalidValueIf(count < 0)
  ctx := GetContext()
  a := arrays[0:count]
  for i in (0 .. count) {
    id := a[i]
    // Silently ignore invalid ids
    if id != 0 {
      // TODO: ctx.UsedNames.VertexArrays[id] = false
      if id in ctx.Instances.VertexArrays {
        ctx.Instances.VertexArrays[id] = null
        if ctx.BoundVertexArray == id {
          ctx.BoundVertexArray = 0
        }
      }
    }
  }
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glEnableVertexAttribArray.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glEnableVertexAttribArray.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glEnableVertexAttribArray.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glEnableVertexAttribArray.xhtml","OpenGL ES 3.2")
cmd void glDisableVertexAttribArray(AttributeLocation location) {
  minRequiredVersion(2, 0)
  glErrorInvalidValueIf(location >= as!AttributeLocation(MAX_VERTEX_ATTRIBS))
  ctx := GetContext()
  vao := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  vao.VertexAttributeArrays[location].Enabled = false
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glEnableVertexAttribArray.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glEnableVertexAttribArray.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glEnableVertexAttribArray.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glEnableVertexAttribArray.xhtml","OpenGL ES 3.2")
cmd void glEnableVertexAttribArray(AttributeLocation location) {
  minRequiredVersion(2, 0)
  glErrorInvalidValueIf(location >= as!AttributeLocation(MAX_VERTEX_ATTRIBS))
  ctx := GetContext()
  vao := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  vao.VertexAttributeArrays[location].Enabled = true
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGenVertexArrays.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGenVertexArrays.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGenVertexArrays.xhtml","OpenGL ES 3.2")
cmd void glGenVertexArrays(GLsizei count, VertexArrayId* arrays) {
  minRequiredVersion(3, 0)
  glErrorInvalidValueIf(count < 0)
  a := arrays[0:count]
  ctx := GetContext()
  for i in (0 .. count) {
    id := as!VertexArrayId(?)
    // Mark the name as used, but do not create the object yet - glIsVertexArray stays false.
    // TODO: ctx.UsedNames.VertexArrays[id] = true
    a[i] = id
  }
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGetVertexAttrib.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGetVertexAttrib.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGetVertexAttrib.xhtml","OpenGL ES 3.2")
cmd void glGetVertexAttribIiv(AttributeLocation index, GLenum pname, GLint* params) {
  minRequiredVersion(3, 0)
  glErrorInvalidValueIf(index >= as!AttributeLocation(MAX_VERTEX_ATTRIBS))
  ctx := GetContext()
  if pname == GL_CURRENT_VERTEX_ATTRIB {
    attr := ctx.VertexAttributes[index]
    write(params[0:4])
    // TODO: params[0:4] = as!GLint[](attr.Value)[0:4]
  } else {
    params[0] = as!GLint(GetVertexAttrib(ctx, index, pname))
  }
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGetVertexAttrib.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGetVertexAttrib.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGetVertexAttrib.xhtml","OpenGL ES 3.2")
cmd void glGetVertexAttribIuiv(AttributeLocation index, GLenum pname, GLuint* params) {
  minRequiredVersion(3, 0)
  glErrorInvalidValueIf(index >= as!AttributeLocation(MAX_VERTEX_ATTRIBS))
  ctx := GetContext()
  if pname == GL_CURRENT_VERTEX_ATTRIB {
    attr := ctx.VertexAttributes[index]
    write(params[0:4])
    // TODO: params[0:4] = as!GLuint[](attr.Value)[0:4]
  } else {
