macro void VertexAttribBinding(ref!Context ctx, AttributeLocation index, BindingIndex binding_index) {
  glErrorInvalidValueIf(index >= as!AttributeLocation(MAX_VERTEX_ATTRIBS))
  glErrorInvalidValueIf(binding_index >= as!BindingIndex(MAX_VERTEX_ATTRIB_BINDINGS))
  // NB: Some callers may use the default VertexArray and some may not.
  //     Therefore the caller should do the check if it is needed.
  vao5 := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  vao5.VertexAttributeArrays[index].Binding = binding_index
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttribBinding.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttribBinding.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribBinding(AttributeLocation index, BindingIndex binding_index) {
  minRequiredVersion(3, 1)
  ctx := GetContext()
  glErrorInvalidOperationIf(ctx.BoundVertexArray == 0)
  VertexAttribBinding(ctx, index, binding_index)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glVertexAttribDivisor.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttribDivisor.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttribDivisor.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribDivisor(AttributeLocation index, GLuint divisor) {
  minRequiredVersion(3, 0)
  ctx := GetContext()
  binding_index := as!BindingIndex(index)
  VertexAttribBinding(ctx, index, binding_index)
  vao := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  vao.VertexBufferBindings[binding_index].Divisor = divisor
}

macro void VertexAttribFormat(ref!Context       ctx,
                              AttributeLocation index,
                              GLint             size,
                              GLenum            type,
                              GLboolean         normalized,
                              GLuint            relativeOffset,
                              bool              integer) {
  glErrorInvalidValueIf(index >= as!AttributeLocation(MAX_VERTEX_ATTRIBS))
  glErrorInvalidValueIf(!((1 <= size) && (size <= 4)))
  if (integer) {
    switch (type) {
      case GL_BYTE, GL_INT, GL_SHORT, GL_UNSIGNED_BYTE, GL_UNSIGNED_INT, GL_UNSIGNED_SHORT: {
        minRequiredVersion(3, 0)
      }
      default: {
        glErrorInvalidEnum(type)
      }
    }
  } else {
    switch (type) {
      case GL_BYTE, GL_FIXED, GL_FLOAT, GL_SHORT, GL_UNSIGNED_BYTE, GL_UNSIGNED_SHORT: {
        minRequiredVersion(2, 0)
      }
      case GL_HALF_FLOAT_OES: {
        requiresExtension(GL_OES_vertex_half_float)
      }
      case GL_HALF_FLOAT, GL_INT, GL_UNSIGNED_INT: {
        minRequiredVersion(3, 0)
      }
      case GL_INT_2_10_10_10_REV, GL_UNSIGNED_INT_2_10_10_10_REV: {
        glErrorInvalidOperationIf(size != 4)
        minRequiredVersion(3, 0)
      }
      default: {
        glErrorInvalidEnum(type)
      }
    }
  }
  // NB: Some callers may use the default VertexArray and some may not.
  //     Therefore the caller should do the check if it is needed.
  glErrorInvalidValueIf(relativeOffset > as!GLuint(MAX_VERTEX_ATTRIB_RELATIVE_OFFSET))
  vao := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  format := vao.VertexAttributeArrays[index]
  format.Size = size
  format.Type = type
  if (!integer) {
    format.Normalized = normalized
  }
  format.RelativeOffset = relativeOffset
  format.Integer = integer
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttribFormat.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttribFormat.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribFormat(AttributeLocation index,
                              GLint             size,
                              GLenum            type,
                              GLboolean         normalized,
                              GLuint            relativeoffset) {
  minRequiredVersion(3, 1)
  ctx := GetContext()
  glErrorInvalidOperationIf(ctx.BoundVertexArray == 0)
  VertexAttribFormat(ctx, index, size, type, normalized, relativeoffset, false)
}

macro void VertexAttribI(AttributeLocation location, Vec4i value) {
  glErrorInvalidValueIf(location >= as!AttributeLocation(MAX_VERTEX_ATTRIBS))
  ctx := GetContext()
  vals := make!Vec4i(1)
  vals[0] = value
  ctx.VertexAttributes[location] = VertexAttributeValue(Value: as!u8[](vals))
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glVertexAttrib.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttrib.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttrib.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribI4i(AttributeLocation index, GLint x, GLint y, GLint z, GLint w) {
  minRequiredVersion(3, 0)
  VertexAttribI(index, Vec4i(x, y, z, w))
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glVertexAttrib.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttrib.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttrib.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribI4iv(AttributeLocation index, const GLint* values) {
  minRequiredVersion(3, 0)
  v := values[0:4]
  VertexAttribI(index, Vec4i(v[0], v[1], v[2], v[3]))
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glVertexAttrib.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttrib.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttrib.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribI4ui(AttributeLocation index, GLuint x, GLuint y, GLuint z, GLuint w) {
  minRequiredVersion(3, 0)
  VertexAttribI(index, Vec4i(as!GLint(x), as!GLint(y), as!GLint(z), as!GLint(w)))
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glVertexAttrib.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttrib.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttrib.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribI4uiv(AttributeLocation index, const GLuint* values) {
  minRequiredVersion(3, 0)
  v := values[0:4]
  VertexAttribI(index, Vec4i(as!GLint(v[0]), as!GLint(v[1]), as!GLint(v[2]), as!GLint(v[3])))
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttribFormat.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttribFormat.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribIFormat(AttributeLocation index, GLint size, GLenum type, GLuint relativeoffset) {
  minRequiredVersion(3, 1)
  ctx := GetContext()
  glErrorInvalidOperationIf(ctx.BoundVertexArray == 0)
  VertexAttribFormat(ctx, index, size, type, as!GLboolean(0), relativeoffset, true)
}

macro void VertexAttribPointer(ref!Context       ctx,
                               AttributeLocation index,
                               GLint             size,
                               GLenum            type,
                               GLboolean         normalized,
                               GLsizei           stride,
                               VertexPointer     pointer,
                               bool              integer) {
  boundArrayBuffer := ctx.BoundBuffers[GL_ARRAY_BUFFER]
  // Do not allow use of client's memory for non-default vertex array.
  glErrorInvalidValueIf(stride < 0) // SPEC: missing in pdf
  glErrorInvalidValueIf(stride > as!GLsizei(MAX_VERTEX_ATTRIB_STRIDE)) // SPEC: missing in html
  glErrorInvalidOperationIf((ctx.BoundVertexArray != 0) && (boundArrayBuffer == 0) && (pointer != null))
  VertexAttribFormat(ctx, index, size, type, normalized, 0, integer)
  binding_index := as!BindingIndex(index)
  VertexAttribBinding(ctx, index, binding_index)
  effectiveStride := switch (stride != 0) {
    case true:  stride
    case false: as!GLsizei(VertexAttribTypeSize(type) * size)
  }
  vao6 := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  vao6.VertexAttributeArrays[index].Stride = stride
  vao6.VertexAttributeArrays[index].Pointer = pointer
  if (ctx.BoundVertexArray == 0) && (boundArrayBuffer == 0) {
    // Use client's memory as data buffer - this is the only way to set it.
    BindVertexBuffer(ctx, binding_index, 0, 0, effectiveStride)
  } else {
    // This call does not allow use of client's memory due to check at the top of function,
    // although it is possible to clear the buffer later while keeping pointer set.
    // I wonder how drivers handle it.  We just ignore non-default vertex arrays.
    offset := as!GLintptr(as!u64(pointer))
    BindVertexBuffer(ctx, binding_index, boundArrayBuffer, offset, effectiveStride)
  }
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glVertexAttribPointer.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttribPointer.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttribPointer.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribIPointer(AttributeLocation location,
                                GLint             size,
                                GLenum            type,
                                GLsizei           stride,
                                VertexPointer     data) {
  minRequiredVersion(3, 0)
  ctx := GetContext()
  VertexAttribPointer(ctx, location, size, type, as!GLboolean(0), stride, data, true)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glVertexAttribPointer.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glVertexAttribPointer.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexAttribPointer.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexAttribPointer.xhtml","OpenGL ES 3.2")
cmd void glVertexAttribPointer(AttributeLocation location,
                               GLint             size,
                               GLenum            type,
                               GLboolean         normalized,
                               GLsizei           stride,
                               VertexPointer     data) {
  minRequiredVersion(2, 0)
  ctx := GetContext()
  VertexAttribPointer(ctx, location, size, type, normalized, stride, data, false)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glVertexBindingDivisor.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glVertexBindingDivisor.xhtml","OpenGL ES 3.2")
cmd void glVertexBindingDivisor(BindingIndex binding_index, GLuint divisor) {
  minRequiredVersion(3, 1)
  ctx := GetContext()
  glErrorInvalidValueIf(binding_index >= as!BindingIndex(MAX_VERTEX_ATTRIB_BINDINGS))
  glErrorInvalidOperationIf(ctx.BoundVertexArray == 0)
  vao := ctx.Instances.VertexArrays[ctx.BoundVertexArray]
  vao.VertexBufferBindings[binding_index].Divisor = divisor
}

