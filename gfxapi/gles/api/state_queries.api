// Implementation dependent constants.
// Default values are based on GLES 3.2 specification.
// NB: New values need to be also added to gles_constants.cpp
//     and to the SetConstant method in this file.
@internal
class Constants {
  string                   Renderer
  string                   Vendor
  string                   Version
  string                   Extensions
  string                   ShadingLanguageVersion
  GLint                    SubpixelBits                               = 4
  GLint64                  MaxElementIndex                            = 0xFFFFFF
  GLint                    Max3dTextureSize                           = 256
  GLint                    MaxTextureSize                             = 2048
  GLint                    MaxArrayTextureLayers                      = 256
  GLfloat                  MaxTextureLodBias                          = 2.0
  GLint                    MaxCubeMapTextureSize                      = 2048
  GLint                    MaxRenderbufferSize                        = 2048
  GLfloat[]                AliasedPointSizeRange                                  // = (1, 1)
  GLfloat[]                AliasedLineWidthRange                                  // = (1, 1)
  GLfloat[]                MultisampleLineWidthRange                              // = (1, 1)
  GLfloat                  MultisampleLineWidthGranularity
  GLint                    MaxDrawBuffers                             = 4
  GLint                    MaxFramebufferWidth                        = 2048
  GLint                    MaxFramebufferHeight                       = 2048
  GLint                    MaxFramebufferLayers                       = 256
  GLint                    MaxFramebufferSamples                      = 4
  GLint                    MaxColorAttachments                        = 4
  GLfloat                  MinFragmentInterpolationOffset             = -0.5
  GLfloat                  MaxFragmentInterpolationOffset             = +0.5
  GLint                    FragmentInterpolationOffsetBits            = 4
  GLint[]                  MaxViewportDims
  GLint                    MaxSampleMaskWords                         = 1
  GLint                    MaxColorTextureSamples                     = 1
  GLint                    MaxDepthTextureSamples                     = 1
  GLint                    MaxIntegerSamples                          = 1
  GLint64                  MaxServerWaitTimeout                       = 0
  GLint                    LayerProvokingVertex
  GLboolean                PrimitiveRestartForPatchesSupported
  GLint                    MaxVertexAttribRelativeOffset              = 2047
  VertexBufferBindingIndex MaxVertexAttribBindings                    = 16
  GLint                    MaxVertexAttribStride                      = 2048
  GLint                    MaxElementsIndices
  GLint                    MaxElementsVertices
  GLint                    MaxTextureBufferSize                       = 65536
  GLint                    NumCompressedTextureFormats                = 10
  GLint[]                  CompressedTextureFormats
  GLint                    NumProgramBinaryFormats                    = 0
  GLint[]                  ProgramBinaryFormats
  GLint                    NumShaderBinaryFormats                     = 0
  GLint[]                  ShaderBinaryFormats
  GLboolean                ShaderCompiler
  GLint                    TextureBufferOffsetAlignment               = 256       // max
  GLint                    NumExtensions
  GLint                    MajorVersion                               = 3
  GLint                    MinorVersion
  GLint                    ContextFlags
  AttributeLocation        MaxVertexAttribs                           = 16
  GLint                    MaxVertexUniformComponents                 = 1024
  GLint                    MaxVertexUniformVectors                    = 256
  GLint                    MaxVertexUniformBlocks                     = 12
  GLint                    MaxVertexOutputComponents                  = 64
  GLint                    MaxVertexTextureImageUnits                 = 16
  GLint                    MaxVertexAtomicCounterBuffers              = 0
  GLint                    MaxVertexAtomicCounters                    = 0
  GLint                    MaxVertexShaderStorageBlocks               = 0
  GLint                    MaxTessGenLevel                            = 64
  GLint                    MaxPatchVertices                           = 32
  GLint                    MaxTessControlUniformComponents            = 1024
  GLint                    MaxTessControlTextureImageUnits            = 16
  GLint                    MaxTessControlOutputComponents             = 64
  GLint                    MaxTessPatchComponents                     = 120
  GLint                    MaxTessControlTotalOutputComponents        = 4096
  GLint                    MaxTessControlInputComponents              = 64
  GLint                    MaxTessControlUniformBlocks                = 12
  GLint                    MaxTessControlAtomicCounterBuffers         = 0
  GLint                    MaxTessControlAtomicCounters               = 0
  GLint                    MaxTessControlShaderStorageBlocks          = 0
  GLint                    MaxTessEvaluationUniformComponents         = 1024
  GLint                    MaxTessEvaluationTextureImageUnits         = 16
  GLint                    MaxTessEvaluationOutputComponents          = 64
  GLint                    MaxTessEvaluationInputComponents           = 64
  GLint                    MaxTessEvaluationUniformBlocks             = 12
  GLint                    MaxTessEvaluationAtomicCounterBuffers      = 0
  GLint                    MaxTessEvaluationAtomicCounters            = 0
  GLint                    MaxTessEvaluationShaderStorageBlocks       = 0
  GLint                    MaxGeometryUniformComponents               = 1024
  GLint                    MaxGeometryUniformBlocks                   = 12
  GLint                    MaxGeometryInputComponents                 = 64
  GLint                    MaxGeometryOutputComponents                = 64
  GLint                    MaxGeometryOutputVertices                  = 256
  GLint                    MaxGeometryTotalOutputComponents           = 1024
  GLint                    MaxGeometryTextureImageUnits               = 16
  GLint                    MaxGeometryShaderInvocations               = 32
  GLint                    MaxGeometryAtomicCounterBuffers            = 0
  GLint                    MaxGeometryAtomicCounters                  = 0
  GLint                    MaxGeometryShaderStorageBlocks             = 0
  GLint                    MaxFragmentUniformComponents               = 1024
  GLint                    MaxFragmentUniformVectors                  = 256
  GLint                    MaxFragmentUniformBlocks                   = 12
  GLint                    MaxFragmentInputComponents                 = 60
  GLint                    MaxTextureImageUnits                       = 16
  GLint                    MaxFragmentAtomicCounterBuffers            = 1
  GLint                    MaxFragmentAtomicCounters                  = 8
  GLint                    MaxFragmentShaderStorageBlocks             = 4
  GLint                    MinProgramTextureGatherOffset
  GLint                    MaxProgramTextureGatherOffset
  GLint                    MinProgramTexelOffset                      = -8
  GLint                    MaxProgramTexelOffset                      = 7
  GLint[]                  MaxComputeWorkGroupCount                               // = (65535, 65535, 65535)
  GLint[]                  MaxComputeWorkGroupSize                                // = (128, 128, 64)
  GLint                    MaxComputeWorkGroupInvocations             = 128
  GLint                    MaxComputeUniformBlocks                    = 12
  GLint                    MaxComputeTextureImageUnits                = 16
  GLint                    MaxComputeSharedMemorySize                 = 16384
  GLint                    MaxComputeUniformComponents                = 1024
  GLint                    MaxComputeAtomicCounterBuffers             = 1
  GLint                    MaxComputeAtomicCounters                   = 8
  GLint                    MaxCombinedComputeUniformComponents
  GLint                    MaxComputeShaderStorageBlocks              = 4
  GLint                    MaxUniformBufferBindings                   = 72
  GLint64                  MaxUniformBlockSize                        = 16384
  GLint                    UniformBufferOffsetAlignment               = 256       // max
  GLint                    MaxCombinedUniformBlocks                   = 60
  GLint64                  MaxCombinedVertexUniformComponents
  GLint                    MaxCombinedTessControlUniformComponents
  GLint                    MaxCombinedTessEvaluationUniformComponents
  GLint                    MaxCombinedGeometryUniformComponents
  GLint64                  MaxCombinedFragmentUniformComponents
  GLint                    MaxVaryingComponents                       = 60
  GLint                    MaxVaryingVectors                          = 15
  GLint                    MaxCombinedTextureImageUnits               = 96
  GLint                    MaxCombinedShaderOutputResources           = 4
  GLint                    MaxUniformLocations                        = 1024
  GLint                    MaxAtomicCounterBufferBindings             = 1
  GLint                    MaxAtomicCounterBufferSize                 = 32
  GLint                    MaxCombinedAtomicCounterBuffers            = 1
  GLint                    MaxCombinedAtomicCounters                  = 8
  GLint                    MaxImageUnits                              = 4
  GLint                    MaxVertexImageUniforms                     = 0
  GLint                    MaxTessControlImageUniforms                = 0
  GLint                    MaxTessEvaluationImageUniforms             = 0
  GLint                    MaxGeometryImageUniforms                   = 0
  GLint                    MaxFragmentImageUniforms                   = 4
  GLint                    MaxComputeImageUniforms                    = 4
  GLint                    MaxCombinedImageUniforms                   = 4
  GLint                    MaxShaderStorageBufferBindings             = 4
  GLint64                  MaxShaderStorageBlockSize                  = 0x8000000
  GLint                    MaxCombinedShaderStorageBlocks             = 4
  GLint                    ShaderStorageBufferOffsetAlignment         = 256       // max
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGet.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGet.xhtml","OpenGL ES 3.2")
cmd void glGetBooleani_v(GLenum param, GLuint index, GLboolean* values) {
  minRequiredVersion(3, 1)
  ctx := GetContext()
  observeGlGetWrites(ctx, param, values)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glGet.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGet.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGet.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGet.xhtml","OpenGL ES 3.2")
cmd void glGetBooleanv(GLenum param, GLboolean* values) {
  minRequiredVersion(1, 0)
  v := values[0:stateVariableSize(param)]
  ctx := GetContext()
  switch (param) {
    case GL_BLEND:
      v[0] = as!GLboolean(ctx.Capabilities[GL_BLEND])
    case GL_CULL_FACE:
      v[0] = as!GLboolean(ctx.Capabilities[GL_CULL_FACE])
    case GL_DEPTH_TEST:
      v[0] = as!GLboolean(ctx.Capabilities[GL_DEPTH_TEST])
    case GL_DITHER:
      v[0] = as!GLboolean(ctx.Capabilities[GL_DITHER])
    case GL_POLYGON_OFFSET_FILL:
      v[0] = as!GLboolean(ctx.Capabilities[GL_POLYGON_OFFSET_FILL])
    case GL_SAMPLE_ALPHA_TO_COVERAGE:
      v[0] = as!GLboolean(ctx.Capabilities[GL_SAMPLE_ALPHA_TO_COVERAGE])
    case GL_SAMPLE_COVERAGE:
      v[0] = as!GLboolean(ctx.Capabilities[GL_SAMPLE_COVERAGE])
    case GL_SCISSOR_TEST:
      v[0] = as!GLboolean(ctx.Capabilities[GL_SCISSOR_TEST])
    case GL_STENCIL_TEST:
      v[0] = as!GLboolean(ctx.Capabilities[GL_STENCIL_TEST])

    case GL_DEPTH_WRITEMASK:
      v[0] = as!GLboolean(ctx.Rasterizing.DepthMask)
    case GL_COLOR_WRITEMASK: {
      v[0] = as!GLboolean(ctx.Rasterizing.ColorMaskRed)
      v[1] = as!GLboolean(ctx.Rasterizing.ColorMaskGreen)
      v[2] = as!GLboolean(ctx.Rasterizing.ColorMaskBlue)
      v[3] = as!GLboolean(ctx.Rasterizing.ColorMaskAlpha)
    }
    case GL_SAMPLE_COVERAGE_INVERT:
      v[0] = as!GLboolean(ctx.Rasterizing.SampleCoverageInvert)
    case GL_SHADER_COMPILER:
      v[0] = ?
    case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
      v[0] = ?

  // TODO: all the values returned by glGetFloatv and glGetIntegerv can
  // be returned here with a type conversion where GL_FALSE is only returned
  // if the value is 0.0 (or 0).
  }
  observeGlGetWrites(ctx, param, values)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glGet.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGet.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGet.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGet.xhtml","OpenGL ES 3.2")
cmd void glGetFloatv(GLenum param, GLfloat* values) {
  minRequiredVersion(1, 0)
  v := values[0:stateVariableSize(param)]
  ctx := GetContext()
  switch (param) {
    case GL_DEPTH_RANGE: {
      v[0] = ctx.Rasterizing.DepthNear
      v[1] = ctx.Rasterizing.DepthFar
    }
    case GL_LINE_WIDTH:
      v[0] = ctx.Rasterizing.LineWidth
    case GL_POLYGON_OFFSET_FACTOR:
      v[0] = ctx.Rasterizing.PolygonOffsetFactor
    case GL_POLYGON_OFFSET_UNITS:
      v[0] = ctx.Rasterizing.PolygonOffsetUnits
    case GL_SAMPLE_COVERAGE_VALUE:
      v[0] = ctx.Rasterizing.SampleCoverageValue
    case GL_COLOR_CLEAR_VALUE: {
      v[0] = ctx.Clearing.ClearColor.Red
      v[1] = ctx.Clearing.ClearColor.Green
      v[2] = ctx.Clearing.ClearColor.Blue
      v[3] = ctx.Clearing.ClearColor.Alpha
    }
    case GL_DEPTH_CLEAR_VALUE:
      v[0] = ctx.Clearing.ClearDepth
    case GL_ALIASED_LINE_WIDTH_RANGE: {
      v[0] = ? /* smallest */
      v[1] = ? /* largest */
    }
    case GL_ALIASED_POINT_SIZE_RANGE: {
      v[0] = ? /* smallest */
      v[1] = ? /* largest */
    }
    case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
      v[0] = ?

  // TODO: all the values returned by glGetBooleanv and glGetIntegerv can
  // be returned here with a type conversion.
  }
  observeGlGetWrites(ctx, param, values)
}

