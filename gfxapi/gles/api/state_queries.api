@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glGet.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGet.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGet.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGet.xhtml","OpenGL ES 3.2")
cmd void glGetIntegerv(GLenum param, GLint* values) {
  minRequiredVersion(1, 0)
  v := values[0:stateVariableSize(param)]
  ctx := GetContext()
  switch (param) {
    case GL_ACTIVE_TEXTURE:
      v[0] = as!GLint(ctx.ActiveTextureUnit)
    case GL_ARRAY_BUFFER_BINDING:
      v[0] = as!GLint(ctx.BoundBuffers[GL_ARRAY_BUFFER])
    case GL_ELEMENT_ARRAY_BUFFER_BINDING:
      v[0] = as!GLint(ctx.BoundBuffers[GL_ELEMENT_ARRAY_BUFFER])
    case GL_BLEND_SRC_ALPHA:
      v[0] = as!GLint(ctx.Blending.SrcAlphaBlendFactor)
    case GL_BLEND_SRC_RGB:
      v[0] = as!GLint(ctx.Blending.SrcRgbBlendFactor)
    case GL_BLEND_DST_ALPHA:
      v[0] = as!GLint(ctx.Blending.DstAlphaBlendFactor)
    case GL_BLEND_DST_RGB:
      v[0] = as!GLint(ctx.Blending.DstRgbBlendFactor)
    case GL_BLEND_EQUATION_RGB:
      v[0] = as!GLint(ctx.Blending.BlendEquationRgb)
    case GL_BLEND_EQUATION_ALPHA:
      v[0] = as!GLint(ctx.Blending.BlendEquationAlpha)
    case GL_BLEND_COLOR: {
      v[0] = as!GLint(ctx.Blending.BlendColor.Red)
      v[1] = as!GLint(ctx.Blending.BlendColor.Green)
      v[2] = as!GLint(ctx.Blending.BlendColor.Blue)
      v[3] = as!GLint(ctx.Blending.BlendColor.Alpha)
    }
    case GL_DEPTH_FUNC:
      v[0] = as!GLint(ctx.Rasterizing.DepthTestFunction)
    case GL_DEPTH_CLEAR_VALUE:
      v[0] = as!GLint(ctx.Clearing.ClearDepth)
    case GL_STENCIL_WRITEMASK:
      v[0] = as!GLint(ctx.Rasterizing.StencilMask[GL_FRONT])
    case GL_STENCIL_BACK_WRITEMASK:
      v[0] = as!GLint(ctx.Rasterizing.StencilMask[GL_BACK])
    case GL_VIEWPORT: {
      v[0] = as!GLint(ctx.Rasterizing.Viewport.X)
      v[1] = as!GLint(ctx.Rasterizing.Viewport.Y)
      v[2] = as!GLint(ctx.Rasterizing.Viewport.Width)
      v[3] = as!GLint(ctx.Rasterizing.Viewport.Height)
    }
    case GL_SCISSOR_BOX: {
      v[0] = as!GLint(ctx.Rasterizing.Scissor.X)
      v[1] = as!GLint(ctx.Rasterizing.Scissor.Y)
      v[2] = as!GLint(ctx.Rasterizing.Scissor.Width)
      v[3] = as!GLint(ctx.Rasterizing.Scissor.Height)
    }
    case GL_FRONT_FACE:
      v[0] = as!GLint(ctx.Rasterizing.FrontFace)
    case GL_CULL_FACE_MODE:
      v[0] = as!GLint(ctx.Rasterizing.CullFace)
    case GL_STENCIL_CLEAR_VALUE:
      v[0] = ctx.Clearing.ClearStencil
    case GL_DRAW_FRAMEBUFFER_BINDING:
      v[0] = as!GLint(ctx.BoundFramebuffers[GL_FRAMEBUFFER])
    case GL_READ_FRAMEBUFFER_BINDING:
      v[0] = as!GLint(ctx.BoundFramebuffers[GL_READ_FRAMEBUFFER])
    case GL_RENDERBUFFER_BINDING:
      v[0] = as!GLint(ctx.BoundRenderbuffers[GL_RENDERBUFFER])
    case GL_CURRENT_PROGRAM:
      v[0] = as!GLint(ctx.BoundProgram)
    case GL_TEXTURE_BINDING_2D:
      v[0] = as!GLint(ctx.TextureUnits[ctx.ActiveTextureUnit].Bindings[GL_TEXTURE_2D])
    case GL_TEXTURE_BINDING_CUBE_MAP:
      v[0] = as!GLint(ctx.TextureUnits[ctx.ActiveTextureUnit].Bindings[GL_TEXTURE_CUBE_MAP])
    case GL_GENERATE_MIPMAP_HINT:
      v[0] = as!GLint(ctx.GenerateMipmapHint)
    case GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS: {
      result := ?
      assert(result > 7)
      v[0] = result
    }
    case GL_MAX_CUBE_MAP_TEXTURE_SIZE: {
      result := ?
      assert(result > 15)
      v[0] = result
    }
    case GL_MAX_FRAGMENT_UNIFORM_VECTORS: {
      result := ?
      assert(result > 15)
      v[0] = result
    }
    case GL_MAX_RENDERBUFFER_SIZE: {
      result := ?
      assert(result > 0)
      v[0] = result
    }
    case GL_MAX_TEXTURE_IMAGE_UNITS: {
      result := ?
      assert(result > 7)
      v[0] = result
    }
    case GL_MAX_TEXTURE_SIZE: {
      result := ?
      assert(result > 63)
      v[0] = result
    }
    case GL_MAX_VARYING_VECTORS: {
      result := ?
      assert(result > 7)
      v[0] = result
    }
    case GL_MAX_VERTEX_ATTRIBS: {
      result := ?
      assert(result > 7)
      v[0] = result
    }
    case GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS:
      v[0] = ?
    case GL_MAX_VERTEX_UNIFORM_VECTORS: {
      result := ?
      assert(result > 127)
      v[0] = result
    }
    case GL_MAX_VIEWPORT_DIMS: {
      max_width := ?
      max_height := ?
      assert(max_width > ctx.Rasterizing.Viewport.Width - 1)
      assert(max_height > ctx.Rasterizing.Viewport.Height - 1)
      v[0] = max_width
      v[1] = max_height
    }
    case GL_NUM_COMPRESSED_TEXTURE_FORMATS: {
      result := ?
      assert(result > -1)
      v[0] = result
    }
    case GL_NUM_SHADER_BINARY_FORMATS: {
      result := ?
      assert(result > -1)
      v[0] = result
    }
    case GL_PACK_ALIGNMENT:
      v[0] = ctx.PixelStorage[GL_PACK_ALIGNMENT]
    case GL_UNPACK_ALIGNMENT:
      v[0] = ctx.PixelStorage[GL_UNPACK_ALIGNMENT]
    case GL_ALPHA_BITS:
      v[0] = ?
    case GL_BLUE_BITS:
      v[0] = ?
    case GL_GREEN_BITS:
      v[0] = ?
    case GL_RED_BITS:
      v[0] = ?
    case GL_DEPTH_BITS:
      v[0] = ?
    case GL_SAMPLE_BUFFERS:
      v[0] = ?
    case GL_SAMPLES:
      v[0] = ?
    case GL_MAX_SAMPLES:
      v[0] = ?
    case GL_NUM_PROGRAM_BINARY_FORMATS:
      v[0] = ?
    case GL_MAX_COLOR_ATTACHMENTS:
      v[0] = ?
    case GL_MAX_UNIFORM_BLOCK_SIZE:
      v[0] = ?
    case GL_MAX_VERTEX_UNIFORM_COMPONENTS:
      v[0] = ?
    /*
      case GL_SHADER_BINARY_FORMATS:
        values = ?  // list of length GL_NUM_SHADER_BINARY_FORMATS
      case GL_COMPRESSED_TEXTURE_FORMATS:
        values = ?  // list of length GL_NUM_COMPRESSED_TEXTURE_FORMATS
      */
    case GL_STENCIL_BITS:
      v[0] = ?
    case GL_SUBPIXEL_BITS: {
      result := ?
      assert(result > 3)
      v[0] = result
    }
    case GL_IMPLEMENTATION_COLOR_READ_FORMAT:
      v[0] = ?
    case GL_IMPLEMENTATION_COLOR_READ_TYPE:
      v[0] = ?
    case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
      v[0] = ?
    case GL_GPU_DISJOINT_EXT:
      v[0] = ?
    case GL_MAJOR_VERSION:
      v[0] = ctx.Constants.MajorVersion
    case GL_MINOR_VERSION:
      v[0] = ctx.Constants.MinorVersion
    // TODO: implement the following which depend on:
    //   glStencilOp, glStencilOpSeparate, glStencilFuncSeparate.
    case GL_STENCIL_BACK_FAIL:
      v[0] = ?
    case GL_STENCIL_BACK_FUNC:
      v[0] = ?
    case GL_STENCIL_BACK_PASS_DEPTH_FAIL:
      v[0] = ?
    case GL_STENCIL_BACK_PASS_DEPTH_PASS:
      v[0] = ?
    case GL_STENCIL_BACK_REF:
      v[0] = ?
    case GL_STENCIL_BACK_VALUE_MASK:
      v[0] = ?
    case GL_STENCIL_FAIL:
      v[0] = ?
    case GL_STENCIL_FUNC:
      v[0] = ?
    case GL_STENCIL_PASS_DEPTH_FAIL:
      v[0] = ?
    case GL_STENCIL_PASS_DEPTH_PASS:
      v[0] = ?
    case GL_STENCIL_REF:
      v[0] = ?
    case GL_STENCIL_TEST:
      v[0] = ?
    case GL_STENCIL_VALUE_MASK:
      v[0] = ?

  // TODO: all the values returned by glGetFloatv and glGetBooleanv can
  // be returned here with a type conversion: "_most_ floating-point values
  // are rounded to the nearest integer value".
  }
  observeGlGetWrites(ctx, param, values)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGetInternalformativ.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGetInternalformativ.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGetInternalformativ.xhtml","OpenGL ES 3.2")
cmd void glGetInternalformativ(GLenum  target,
                               GLenum  internalformat,
                               GLenum  pname,
                               GLsizei bufSize,
                               GLint*  params) {
  minRequiredVersion(3, 0)
  switch (target) {
    case GL_RENDERBUFFER: {
      // version 3.0
    }
    case GL_TEXTURE_2D_MULTISAMPLE: {
      minRequiredVersion(3, 1)
    }
    case GL_TEXTURE_2D_MULTISAMPLE_ARRAY: {
      minRequiredVersion(3, 2)
    }
    default: {
      glErrorInvalidEnum(target)
    }
  }
  switch (internalformat) {
    case GL_DEPTH24_STENCIL8, GL_DEPTH32F_STENCIL8, GL_DEPTH_COMPONENT16, GL_DEPTH_COMPONENT24,
        GL_DEPTH_COMPONENT32F, GL_R11F_G11F_B10F, GL_R16F, GL_R16I, GL_R16UI, GL_R32F, GL_R32I,
        GL_R32UI, GL_R8, GL_R8I, GL_R8UI, GL_R8_SNORM, GL_RG16F, GL_RG16I, GL_RG16UI, GL_RG32F,
        GL_RG32I, GL_RG32UI, GL_RG8, GL_RG8I, GL_RG8UI, GL_RG8_SNORM, GL_RGB10_A2, GL_RGB10_A2UI,
        GL_RGB16F, GL_RGB16I, GL_RGB16UI, GL_RGB32F, GL_RGB32I, GL_RGB32UI, GL_RGB565, GL_RGB5_A1,
        GL_RGB8, GL_RGB8I, GL_RGB8UI, GL_RGB8_SNORM, GL_RGB9_E5, GL_RGBA16F, GL_RGBA16I,
        GL_RGBA16UI, GL_RGBA32F, GL_RGBA32I, GL_RGBA32UI, GL_RGBA4, GL_RGBA8, GL_RGBA8I,
        GL_RGBA8UI, GL_RGBA8_SNORM, GL_SRGB8, GL_SRGB8_ALPHA8: {
      // version 3.0
    }
    case GL_STENCIL_INDEX8: {
      minRequiredVersion(3, 2)
    }
    default: {
      glErrorInvalidEnum(internalformat)
    }
  }
  switch (pname) {
    case GL_NUM_SAMPLE_COUNTS, GL_SAMPLES: {
      // version 3.0
    }
    default: {
      glErrorInvalidEnum(pname)
    }
  }
  // TODO
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glGetString.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGetString.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGetString.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGetString.xhtml","OpenGL ES 3.2")
cmd const GLubyte* glGetString(GLenum param) {
  minRequiredVersion(1, 0)
  switch (param) {
    case GL_EXTENSIONS, GL_RENDERER, GL_SHADING_LANGUAGE_VERSION, GL_VENDOR, GL_VERSION: {
      // version 2.0
    }
    default: {
      glErrorInvalidEnum(param)
    }
  }

  return null
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glGetString.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glGetString.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGetString.xhtml","OpenGL ES 3.2")
cmd const GLubyte* glGetStringi(GLenum name, GLuint index) {
  minRequiredVersion(3, 0)
  switch (name) {
    case GL_EXTENSIONS: {
      // version 3.0
    }
    default: {
      glErrorInvalidEnum(name)
    }
  }
  // TODO
  return ?
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glIsEnabled.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glIsEnabled.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glIsEnabled.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glIsEnabled.xhtml","OpenGL ES 3.2")
cmd GLboolean glIsEnabled(GLenum capability) {
  minRequiredVersion(1, 0)
  switch (capability) {
    case GL_BLEND, GL_CULL_FACE, GL_DEPTH_TEST, GL_DITHER, GL_POLYGON_OFFSET_FILL,
        GL_SAMPLE_ALPHA_TO_COVERAGE, GL_SAMPLE_COVERAGE, GL_SCISSOR_TEST, GL_STENCIL_TEST: {
      // version 2.0
    }
    case GL_PRIMITIVE_RESTART_FIXED_INDEX, GL_RASTERIZER_DISCARD: {
      minRequiredVersion(3, 0)
    }
    case GL_DEBUG_OUTPUT, GL_DEBUG_OUTPUT_SYNCHRONOUS, GL_SAMPLE_MASK: {
      minRequiredVersion(3, 2)
    }
    default: {
      glErrorInvalidEnum(capability)
    }
  }

  ctx := GetContext()
  return as!GLboolean(ctx.Capabilities[capability])
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glIsEnabled.xhtml","OpenGL ES 3.2")
cmd GLboolean glIsEnabledi(GLenum target, GLuint index) {
  minRequiredVersion(3, 2)
  return IsEnabledi(target, index)
}

macro GLboolean IsEnabledi(GLenum target, GLuint index) {
  switch (target) {
    case GL_BLEND, GL_CULL_FACE, GL_DEBUG_OUTPUT, GL_DEBUG_OUTPUT_SYNCHRONOUS, GL_DEPTH_TEST,
        GL_DITHER, GL_POLYGON_OFFSET_FILL, GL_PRIMITIVE_RESTART_FIXED_INDEX, GL_RASTERIZER_DISCARD,
        GL_SAMPLE_ALPHA_TO_COVERAGE, GL_SAMPLE_COVERAGE, GL_SAMPLE_MASK, GL_SCISSOR_TEST,
        GL_STENCIL_TEST: {
      // version 3.2
    }
    default: {
      glErrorInvalidEnum(target)
    }
  }
  // TODO
  return ?
}

