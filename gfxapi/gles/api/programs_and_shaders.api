macro void ProgramUniformMatrixv(ProgramId       program,
                                 UniformLocation location,
                                 GLboolean       transpose,
                                 any             values,
                                 GLenum          type) {
  ctx := GetContext()
  p := ctx.Instances.Programs[program]
  // TODO: transpose values if the flag is set
  uniform := p.Uniforms[location]
  uniform.Value = clone(as!u8[](values))
  uniform.Type = type
  p.Uniforms[location] = uniform
}

