macro void UniformMatrixv(UniformLocation location,
                          GLboolean       transpose,
                          any             values,
                          GLenum          type) {
  minRequiredVersion(2, 0)
  // TODO: Transpose if the flag is set.
  ctx := GetContext()
  program := ctx.Instances.Programs[ctx.BoundProgram]
  uniform := program.Uniforms[location]
  uniform.Value = clone(as!u8[](values))
  uniform.Type = type
  program.Uniforms[location] = uniform
}

