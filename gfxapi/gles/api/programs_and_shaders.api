type GLuint UniformIndex

macro void readString(GLsizei length, const GLchar* buffer) {
  if buffer != null {
    if length < 0 {
      // Negative length implies null-terminated string
      msg := as!string(as!char*(buffer))
    } else {
      read(buffer[0:length])
    }
  }
}

macro void writeString(GLsizei  buffer_size,
                       GLsizei* buffer_bytes_written,
                       GLchar*  buffer) {
  if (buffer != null) && (buffer_size > 0) {
    buffer_size2 := buffer_size // Read before fence
    if buffer_bytes_written != null {
      length := as!GLsizei(?)
      buffer_bytes_written[0] = length // Excluding null-terminator
      write(buffer[0:length + 1]) // Including null-terminator
    } else {
      write(buffer[0:buffer_size2])
    }
  }
}

