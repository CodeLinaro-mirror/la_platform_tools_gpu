@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glGetProgramBinary.xhtml","OpenGL ES 3.2")
cmd void glGetProgramBinary(ProgramId program,
                            GLsizei   bufSize,
                            GLsizei*  length,
                            GLenum*   binaryFormat,
                            void*     binary) {
  minRequiredVersion(3, 0)
  GetProgramBinary(program, bufSize, length, binaryFormat, binary)
}

macro void GetProgramBinary(ProgramId program, GLsizei bufSize, GLsizei* length, GLenum* binaryFormat, void* binary) {

  if length != null {
    l := as!GLsizei(?)
    length[0] = l
    write(binary[0:l])
  } else {
    write(binary[0:bufSize])
  }
  binaryFormat[0] = ?
}

