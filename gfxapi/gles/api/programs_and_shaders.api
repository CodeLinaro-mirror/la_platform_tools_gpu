cmd void glGetActiveUniformsiv(ProgramId           program,
                               GLsizei             uniform_count,
                               const UniformIndex* uniform_indices,
                               GLenum              parameter_name,
                               GLint*              parameters) {
  minRequiredVersion(3, 0)
