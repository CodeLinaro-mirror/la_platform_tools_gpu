                              GLsizei         count,
                              GLboolean       transpose,
                              const GLfloat*  values) {
  minRequiredVersion(3, 0)
  UniformMatrix4x3fv(location, count, transpose, values)
}

macro void UniformMatrix4x3fv(UniformLocation location, GLsizei count, GLboolean transpose, const GLfloat* values) {
  v := as!Mat4x3f*(values)[0:count]
  UniformMatrixv(location, transpose, v, GL_FLOAT_MAT4x3)
}

@Doc("https://www.khronos.org/opengles/sdk/docs/man/xhtml/glUseProgram.xml","OpenGL ES 2.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man3/html/glUseProgram.xhtml","OpenGL ES 3.0")
@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glUseProgram.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glUseProgram.xhtml","OpenGL ES 3.2")
cmd void glUseProgram(ProgramId program) {
  minRequiredVersion(2, 0)

  ctx := GetContext()
  ctx.BoundProgram = program
}

