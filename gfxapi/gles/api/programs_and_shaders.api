macro void ProgramUniformv(ProgramId       program,
                           UniformLocation location,
                           any             values,
                           GLenum          type) {
  ctx := GetContext()
  p := ctx.Instances.Programs[program]
  uniform := p.Uniforms[location]
  uniform.Value = clone(as!u8[](values))
  uniform.Type = type
  p.Uniforms[location] = uniform
}

