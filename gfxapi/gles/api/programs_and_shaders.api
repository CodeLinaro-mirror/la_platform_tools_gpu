@Doc("https://www.khronos.org/opengles/sdk/docs/man31/html/glProgramBinary.xhtml","OpenGL ES 3.1")
@Doc("https://www.khronos.org/opengles/sdk/docs/man32/html/glProgramBinary.xhtml","OpenGL ES 3.2")
cmd void glProgramBinary(ProgramId   program,
                         GLenum      binaryFormat,
                         const void* binary,
                         GLsizei     length) {
  minRequiredVersion(3, 0)
  ProgramBinary(program, binaryFormat, binary, length)
}

macro void ProgramBinary(ProgramId program, GLenum binaryFormat, const void* binary, GLsizei length) {
  ctx := GetContext()
  p := ctx.Instances.Programs[program]
  switch (binaryFormat) {
    case GL_Z400_BINARY_AMD: {
      read(binary[0:length])
      resolveAttributesAndUniforms(p, program)
    }
    default: {
      glErrorInvalidEnum(binaryFormat)
    }
  }
}

