cmd void glAttachShader(ProgramId program, ShaderId shader) {
  minRequiredVersion(2, 0)

  ctx := GetContext()
  p := ctx.Instances.Programs[program]
  s := ctx.Instances.Shaders[shader]
  p.Shaders[s.Type] = shader
}

