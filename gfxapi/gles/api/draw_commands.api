    case GL_LINES, GL_LINE_LOOP, GL_LINE_STRIP, GL_POINTS, GL_TRIANGLES, GL_TRIANGLE_FAN,
        GL_TRIANGLE_STRIP: {
      // version 3.1
    }
    default: {
      glErrorInvalidEnum(mode)
    }
  }
  switch (type) {
    case GL_UNSIGNED_BYTE, GL_UNSIGNED_INT, GL_UNSIGNED_SHORT: {
      // version 3.1
    }
    default: {
      glErrorInvalidEnum(type)
    }
  }
  // TODO
}

