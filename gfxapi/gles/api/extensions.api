cmd void glDeleteVertexArraysOES(GLsizei count, const VertexArrayId* arrays) {
  requiresExtension(GL_OES_vertex_array_object)

  ctx := GetContext()
  a := arrays[0:count]
  for i in (0 .. count) {
    ctx.Instances.VertexArrays[a[i]] = null
  }
}

