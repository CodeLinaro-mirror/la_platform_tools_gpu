cmd void glPushGroupMarkerEXT(GLsizei length, const GLchar* marker) {
  requiresExtension(GL_EXT_debug_marker)

  if length > 0 {
    read(marker[0:length])
  } else {
    _ = as!string(as!char*(marker))
  }
}

