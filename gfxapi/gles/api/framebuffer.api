cmd void glDeleteRenderbuffers(GLsizei count, const RenderbufferId* renderbuffers) {
  minRequiredVersion(2, 0)

  r := renderbuffers[0:count]
  ctx := GetContext()
  for i in (0 .. count) {
    ctx.Instances.Renderbuffers[r[i]] = null
  }
