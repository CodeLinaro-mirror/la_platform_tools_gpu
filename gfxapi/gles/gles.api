class Color {
    f32 Red
    f32 Green
    f32 Blue
    f32 Alpha
}

class Rect {
  s32 X
  s32 Y
  s32 Width
  s32 Height
}

class Image {
    s32              Width
    s32              Height
    memory           Data
    s32              Size
    ImageTexelFormat Format
}

@Interface class FramebufferAttachable{}

class Renderbuffer : FramebufferAttachable {
    s32                Width
    s32                Height
    memory             Data
    RenderbufferFormat Format
}

class Texture : FramebufferAttachable {
    TextureKind       Kind
    ImageTexelFormat  Format
    map<s32, Image>        Texture2D
    map<s32, CubemapLevel> Cubemap
    TextureFilterMode MagFilter = GL_LINEAR
    TextureFilterMode MinFilter = GL_NEAREST_MIPMAP_LINEAR
    TextureWrapMode   WrapS = GL_REPEAT
    TextureWrapMode   WrapT = GL_REPEAT
    TexelComponent    SwizzleR = GL_RED
    TexelComponent    SwizzleG = GL_GREEN
    TexelComponent    SwizzleB = GL_BLUE
    TexelComponent    SwizzleA = GL_ALPHA
    f32             MaxAnisotropy = 1.0  // EXT/texture_filter_anisotropic
}

class CubemapLevel {
    map<CubeMapImageTarget, Image> Faces
}

class FramebufferAttachmentInfo {
    u32                       Object
    FramebufferAttachmentType Type
    s32                       TextureLevel
    CubeMapImageTarget        CubeMapFace
}

class Framebuffer{
    map<FramebufferAttachment, FramebufferAttachmentInfo> Attachments
}

class Buffer {
    memory      Data
    s32         Size = 0
    BufferUsage Usage = GL_STATIC_DRAW
}

class Shader {
    memory        Binary
    bool          Compiled = false
    bool          Deletable = false
    string        InfoLog
    array<string> Source
    ShaderType    Type
}

class VertexAttribute {
    string           Name
    s32              VectorCount
    ShaderAttribType Type
}

class Vec2i { s32 X, s32 Y }
class Vec3i { s32 X, s32 Y, s32 Z }
class Vec4i { s32 X, s32 Y, s32 Z, s32 W }

class Vec2f { f32 X, f32 Y }
class Vec3f { f32 X, f32 Y, f32 Z }
class Vec4f { f32 X, f32 Y, f32 Z, f32 W }

class Mat2f {
  Vec2f Col0
  Vec2f Col1
}

class Mat3f {
  Vec3f Col0
  Vec3f Col1
  Vec3f Col2
}

class Mat4f {
  Vec4f Col0
  Vec4f Col1
  Vec4f Col2
  Vec4f Col3
}

class Uniform {
    string Name
    any    Value
}

class Program{
    map<ShaderType, ShaderId>       Shaders
    bool                            Linked
    memory                          Binary
    map<string, AttributeLocation>  AttributeBindings
    map<s32, VertexAttribute>       Attributes
    map<UniformLocation, Uniform>   Uniforms
    string                          InfoLog
}

class VertexArray {}

class VertexAttributeArray {
    bool             Enabled = false
    VertexAttribSize Size = SIZE_4
    VertexAttribType Type = GL_FLOAT
    bool             Normalized = false
    s32              Stride = 0
    pointer          Data
}

class Query {
}

/////////////////////////////////////////////////////////////////
// State
/////////////////////////////////////////////////////////////////

class BlendState {
    BlendFactor                     SrcRgbBlendFactor = GL_ONE
    BlendFactor                     SrcAlphaBlendFactor = GL_ZERO
    BlendFactor                     DstRgbBlendFactor = GL_ONE
    BlendFactor                     DstAlphaBlendFactor = GL_ZERO
    BlendEquation                   BlendEquationRgb = GL_FUNC_ADD
    BlendEquation                   BlendEquationAlpha = GL_FUNC_ADD
    Color                           BlendColor
}

class RasterizerState {
    bool                            DepthMask = true
    TestFunction                    DepthTestFunction = GL_LESS
    f32                             DepthNear = 0.0
    f32                             DepthFar = 1.0
    bool                            ColorMaskRed = true
    bool                            ColorMaskGreen = true
    bool                            ColorMaskBlue = true
    bool                            ColorMaskAlpha = true
    map<FaceMode, u32>              StencilMask
    Rect                            Viewport
    Rect                            Scissor
    FaceOrientation                 FrontFace = GL_CCW
    FaceMode                        CullFace = GL_BACK
    f32                             LineWidth = 1.0
    f32                             PolygonOffsetFactor
    f32                             PolygonOffsetUnits
    f32                             SampleCoverageValue = 1.0
    bool                            SampleCoverageInvert
}

class ClearState {
    Color                           ClearColor
    f32                             ClearDepth = 1.0
    s32                             ClearStencil
}

class InternalState {
    BufferId                        NilBuffer = 0
    TextureId                       NilTexture = 0
    RenderbufferId                  NilRenderbuffer = 0
    FramebufferId                   Backbuffer = 0
}

@replay_remap type u32 RenderbufferId
@replay_remap type u32 TextureId
@replay_remap type u32 FramebufferId
@replay_remap type u32 BufferId
@replay_remap type u32 ShaderId
@replay_remap type u32 ProgramId
@replay_remap type u32 VertexArrayId
@replay_remap type u32 QueryId
// @replay_remap type u32 SyncObjectId
@replay_remap type s32 UniformLocation

type s32 AttributeLocation

@replay_custom_value type pointer IndicesPointer
@replay_custom_value type pointer VertexPointer
@replay_custom_value type pointer TexturePointer
@replay_custom_value type pointer BufferDataPointer

class Objects {
    map<RenderbufferId, Renderbuffer*>    Renderbuffers
    map<TextureId, Texture*>              Textures
    map<FramebufferId, Framebuffer*>      Framebuffers
    map<BufferId, Buffer*>                Buffers
    map<ShaderId, Shader*>                Shaders
    map<ProgramId, Program*>              Programs
    map<VertexArrayId, VertexArray*>      VertexArrays
//    map<SyncObjectId, SyncObject*>        SyncObjects
    map<QueryId, Query*>                  Queries
}


// TODO: Move Globals into Context
    BlendState                                        Blending
    RasterizerState                                   Rasterizing
    ClearState                                        Clearing
    map<FramebufferTarget, FramebufferId>             BoundFramebuffers
    map<RenderbufferTarget, RenderbufferId>           BoundRenderbuffers
    map<BufferTarget, BufferId>                       BoundBuffers
    ProgramId                                         BoundProgram
    VertexArrayId                                     BoundVertexArray
    map<AttributeLocation, VertexAttributeArray*>     VertexAttributeArrays
    TextureUnitMap                                    TextureUnits
    TextureUnit                                       ActiveTextureUnit = GL_TEXTURE0
    map<Capability, bool>                             Capabilities
    InternalState                                     Internals
    HintMode                                          GenerateMipmapHint = GL_DONT_CARE
    map<PixelStoreParameter, s32>                     PixelStorage
    Objects                                           Instances

/////////////////////////////////////////////////////////////////
// Synthetic APIs
/////////////////////////////////////////////////////////////////

@synthetic
cmd void init(s32                width,
              s32                height,
              RenderbufferFormat color_fmt,
              RenderbufferFormat depth_fmt,
              RenderbufferFormat stencil_fmt) {
    http://www.khronos.org/opengles/sdk/1.1/docs/man

    Instances.Buffers[Internals.NilBuffer] = new Buffer{}
    Instances.Textures[Internals.NilTexture] = new Texture{}
    Instances.Renderbuffers[Internals.NilRenderbuffer] = new Renderbuffer{}

    backbufferColorId   := 0xffffffff as RenderbufferId
    backbufferDepthId   := 0xfffffffe as RenderbufferId
    backbufferStencilId := 0xfffffffd as RenderbufferId

    backbufferColor         := new Renderbuffer{}
    backbufferColor.Width    = width
    backbufferColor.Height   = height
    backbufferColor.Format   = color_fmt
    Instances.Renderbuffers[backbufferColorId] = backbufferColor

    backbufferDepth         := new Renderbuffer{}
    backbufferDepth.Width    = width
    backbufferDepth.Height   = height
    backbufferDepth.Format   = depth_fmt
    Instances.Renderbuffers[backbufferDepthId] = backbufferDepth

    backbufferStencil       := new Renderbuffer{}
    backbufferStencil.Width  = width
    backbufferStencil.Height = height
    backbufferStencil.Format = stencil_fmt
    Instances.Renderbuffers[backbufferStencilId] = backbufferStencil

    backbuffer := new Framebuffer{}
    backbuffer.Attachments[GL_COLOR_ATTACHMENT0] = FramebufferAttachmentInfo{
        Object:      backbufferColorId as u32,
        Type:        GL_RENDERBUFFER,
        CubeMapFace: GL_TEXTURE_CUBE_MAP_POSITIVE_X,
    }

    backbuffer.Attachments[GL_DEPTH_ATTACHMENT] = FramebufferAttachmentInfo{
        Object:      backbufferDepthId as u32,
        Type:        GL_RENDERBUFFER,
        CubeMapFace: GL_TEXTURE_CUBE_MAP_POSITIVE_X,
    }

    backbuffer.Attachments[GL_STENCIL_ATTACHMENT] = FramebufferAttachmentInfo{
        Object:      backbufferStencilId as u32,
        Type:        GL_RENDERBUFFER,
        CubeMapFace: GL_TEXTURE_CUBE_MAP_POSITIVE_X,
    }

    Instances.Framebuffers[Internals.Backbuffer] = backbuffer

    BoundFramebuffers[GL_FRAMEBUFFER] = Internals.Backbuffer

    TextureUnits = createTextureUnits(Internals)

    Rasterizing.Scissor.Width       = width
    Rasterizing.Scissor.Height      = height
    // TODO: Stencil function
    Rasterizing.StencilMask[GL_FRONT] = 0xFFFFFFFF
    Rasterizing.StencilMask[GL_BACK]  = 0xFFFFFFFF
    Rasterizing.Viewport.Width        = width
    Rasterizing.Viewport.Height       = height

    PixelStorage[GL_PACK_ALIGNMENT] = 4
    PixelStorage[GL_UNPACK_ALIGNMENT] = 4

    for i in (0 .. 64) { // TODO: Count
        VertexAttributeArrays[i as AttributeLocation] = new VertexAttributeArray{}
    }
}

@synthetic
cmd void startTimer(u8 index) {}

@synthetic
cmd u64 stopTimer(u8 index) { return ? } // Time returned in nanoseconds

@synthetic
cmd void flushPostBuffer() {}

