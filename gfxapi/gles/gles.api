///http://www.khronos.org/opengles/sdk/docs/man3/html/glGenQueries.xhtml
cmd void glGenQueries(s32 count, QueryId* queries) {
  q := queries[0:count]
  ctx := GetContext()
  for i in (0 .. count) {
    id := as!QueryId(?)
    ctx.Instances.Queries[id] = new!Query()
    q[i] = id
  }
}

