    ctx.Instances.VertexArrays[id] = new!VertexArray()
    a[i] = id
  }
}

///http://www.khronos.org/opengles/sdk/docs/man3/html/glBindVertexArray.xhtml
cmd void glBindVertexArray(VertexArrayId array) {
  ctx := GetContext()
  if !(array in ctx.Instances.VertexArrays) {
    ctx.Instances.VertexArrays[array] = new!VertexArray()
  }
  ctx.BoundVertexArray = array
}

///http://www.khronos.org/opengles/sdk/docs/man3/html/glDeleteVertexArrays.xhtml
cmd void glDeleteVertexArrays(u32 count, const VertexArrayId* arrays) {
  ctx := GetContext()
  a := arrays[0:count]
  for i in (0 .. count) {
    ctx.Instances.VertexArrays[a[i]] = null
  }
}

