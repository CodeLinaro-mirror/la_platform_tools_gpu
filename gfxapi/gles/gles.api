// OES_vertex_array_object

cmd void glGenVertexArraysOES(s32 count, inout array<VertexArrayId> arrays) {
    http://www.khronos.org/registry/gles/extensions/OES/OES_vertex_array_object.txt
    assert len(arrays) >= count
    for i in (0 .. count) {
        arrays[i] = ? as VertexArrayId
        Instances.VertexArrays[arrays[i]] = new VertexArray{}
    }
}

cmd void glBindVertexArrayOES(VertexArrayId array) {
    http://www.khronos.org/registry/gles/extensions/OES/OES_vertex_array_object.txt
    if ((array in Instances.VertexArrays) == false) {
      Instances.VertexArrays[array] = new VertexArray{}
    }
    BoundVertexArray = array
}

cmd void glDeleteVertexArraysOES(s32 count, array<VertexArrayId> arrays) {
    http://www.khronos.org/registry/gles/extensions/OES/OES_vertex_array_object.txt
    assert len(arrays) >= count
    for i in (0 .. count) {
      Instances.VertexArrays.Delete(arrays[i])
    }
}

cmd bool glIsVertexArrayOES(VertexArrayId array) {
    http://www.khronos.org/registry/gles/extensions/OES/OES_vertex_array_object.txt
    return array in Instances.VertexArrays
}

