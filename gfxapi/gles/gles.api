///http://www.khronos.org/registry/gles/extensions/OES/OES_get_program_binary.txt
cmd void glGetProgramBinaryOES(ProgramId program,
                               s32       buffer_size,
                               s32*      bytes_written,
                               u32*      binary_format,
                               void*     binary) {
  l := as!s32(?)
  bytes_written[0] = l
  binary_format[0] = ?
