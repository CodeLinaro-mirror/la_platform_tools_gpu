    http://www.khronos.org/registry/gles/extensions/OES/OES_EGL_image.txt
}

cmd void glEGLImageTargetRenderbufferStorageOES(ImageTargetRenderbufferStorage target, TexturePointer image) {
    http://www.khronos.org/registry/gles/extensions/OES/OES_EGL_image.txt
}

