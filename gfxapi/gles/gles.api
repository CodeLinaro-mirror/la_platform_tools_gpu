cmd void glGetBooleanv(StateVariable param, inout array<bool> values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glGet.xml
    assert len(values) >= stateVariableSize(param)
    switch (param) {
      case GL_BLEND:
        values[0] = Capabilities[GL_BLEND]
      case GL_CULL_FACE:
        values[0] = Capabilities[GL_CULL_FACE]
      case GL_DEPTH_TEST:
        values[0] = Capabilities[GL_DEPTH_TEST]
      case GL_DITHER:
        values[0] = Capabilities[GL_DITHER]
      case GL_POLYGON_OFFSET_FILL:
        values[0] = Capabilities[GL_POLYGON_OFFSET_FILL]
      case GL_SAMPLE_ALPHA_TO_COVERAGE:
        values[0] = Capabilities[GL_SAMPLE_ALPHA_TO_COVERAGE]
      case GL_SAMPLE_COVERAGE:
        values[0] = Capabilities[GL_SAMPLE_COVERAGE]
      case GL_SCISSOR_TEST:
        values[0] = Capabilities[GL_SCISSOR_TEST]
      case GL_STENCIL_TEST:
        values[0] = Capabilities[GL_STENCIL_TEST]

      case GL_DEPTH_WRITEMASK:
        values[0] = Rasterizing.DepthMask
      case GL_COLOR_WRITEMASK: {
        values[0] = Rasterizing.ColorMaskRed
        values[1] = Rasterizing.ColorMaskGreen
        values[2] = Rasterizing.ColorMaskBlue
        values[3] = Rasterizing.ColorMaskAlpha
      }
      case GL_SAMPLE_COVERAGE_INVERT:
        values[0] = Rasterizing.SampleCoverageInvert
      case GL_SHADER_COMPILER:
        values[0] = ?
      case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
        values[0] = ?

      // TODO: all the values returned by glGetFloatv and glGetIntegerv can
      // be returned here with a type conversion where GL_FALSE is only returned
      // if the value is 0.0 (or 0).
    }
}

cmd void glGetFloatv(StateVariable param, inout array<f32> values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glGet.xml
    assert len(values) >= stateVariableSize(param)
    switch (param) {
      case GL_DEPTH_RANGE: {
        values[0] = Rasterizing.DepthNear
        values[1] = Rasterizing.DepthFar
      }
      case GL_LINE_WIDTH:
        values[0] = Rasterizing.LineWidth
      case GL_POLYGON_OFFSET_FACTOR:
        values[0] = Rasterizing.PolygonOffsetFactor
      case GL_POLYGON_OFFSET_UNITS:
        values[0] = Rasterizing.PolygonOffsetUnits
      case GL_SAMPLE_COVERAGE_VALUE:
        values[0] = Rasterizing.SampleCoverageValue
      case GL_COLOR_CLEAR_VALUE: {
        values[0] = Clearing.ClearColor.Red
        values[1] = Clearing.ClearColor.Green
        values[2] = Clearing.ClearColor.Blue
        values[3] = Clearing.ClearColor.Alpha
      }
      case GL_DEPTH_CLEAR_VALUE:
        values[0] = Clearing.ClearDepth
      case GL_ALIASED_LINE_WIDTH_RANGE: {
        values[0] = ?  /* smallest */
        values[1] = ?  /* largest */
      }
      case GL_ALIASED_POINT_SIZE_RANGE: {
        values[0] = ?  /* smallest */
        values[1] = ?  /* largest */
      }
      case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
        values[0] = ?

      // TODO: all the values returned by glGetBooleanv and glGetIntegerv can
      // be returned here with a type conversion.
    }
}

cmd void glGetIntegerv(StateVariable param, inout array<s32> values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glGet.xml
    assert len(values) >= stateVariableSize(param)
    switch (param) {
      case GL_ACTIVE_TEXTURE:
        values[0] = ActiveTextureUnit as s32
      case GL_ARRAY_BUFFER_BINDING:
        values[0] = BoundBuffers[GL_ARRAY_BUFFER] as s32
      case GL_ELEMENT_ARRAY_BUFFER_BINDING:
        values[0] = BoundBuffers[GL_ELEMENT_ARRAY_BUFFER] as s32
      case GL_BLEND_SRC_ALPHA:
        values[0] = Blending.SrcAlphaBlendFactor as s32
      case GL_BLEND_SRC_RGB:
        values[0] = Blending.SrcRgbBlendFactor as s32
      case GL_BLEND_DST_ALPHA:
        values[0] = Blending.DstAlphaBlendFactor as s32
      case GL_BLEND_DST_RGB:
        values[0] = Blending.DstRgbBlendFactor as s32
      case GL_BLEND_EQUATION_RGB:
        values[0] = Blending.BlendEquationRgb as s32
      case GL_BLEND_EQUATION_ALPHA:
        values[0] = Blending.BlendEquationAlpha as s32
      case GL_BLEND_COLOR: {
        values[0] = Blending.BlendColor.Red as s32
        values[1] = Blending.BlendColor.Green as s32
        values[2] = Blending.BlendColor.Blue as s32
        values[3] = Blending.BlendColor.Alpha as s32
      }
      case GL_DEPTH_FUNC:
        values[0] = Rasterizing.DepthTestFunction as s32
      case GL_DEPTH_CLEAR_VALUE:
        values[0] = Clearing.ClearDepth as s32
      case GL_STENCIL_WRITEMASK:
        values[0] = Rasterizing.StencilMask[GL_FRONT] as s32
      case GL_STENCIL_BACK_WRITEMASK:
        values[0] = Rasterizing.StencilMask[GL_BACK] as s32
      case GL_VIEWPORT: {
        values[0] = Rasterizing.Viewport.X
        values[1] = Rasterizing.Viewport.Y
        values[2] = Rasterizing.Viewport.Width
        values[3] = Rasterizing.Viewport.Height
      }
      case GL_SCISSOR_BOX: {
        values[0] = Rasterizing.Scissor.X
        values[1] = Rasterizing.Scissor.Y
        values[2] = Rasterizing.Scissor.Width
        values[3] = Rasterizing.Scissor.Height
      }
      case GL_FRONT_FACE:
        values[0] = Rasterizing.FrontFace as s32
      case GL_CULL_FACE_MODE:
        values[0] = Rasterizing.CullFace as s32
      case GL_STENCIL_CLEAR_VALUE:
        values[0] = Clearing.ClearStencil
      case GL_FRAMEBUFFER_BINDING:
        values[0] = BoundFramebuffers[GL_FRAMEBUFFER] as s32
      case GL_READ_FRAMEBUFFER_BINDING:
        values[0] = BoundFramebuffers[GL_READ_FRAMEBUFFER] as s32
      case GL_RENDERBUFFER_BINDING:
        values[0] = BoundRenderbuffers[GL_RENDERBUFFER] as s32
      case GL_CURRENT_PROGRAM:
        values[0] = BoundProgram as s32
      case GL_TEXTURE_BINDING_2D:
        values[0] = TextureUnits[ActiveTextureUnit][GL_TEXTURE_2D] as s32
      case GL_TEXTURE_BINDING_CUBE_MAP:
        values[0] = TextureUnits[ActiveTextureUnit][GL_TEXTURE_CUBE_MAP] as s32
      case GL_GENERATE_MIPMAP_HINT:
        values[0] = GenerateMipmapHint as s32
      case GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS: {
        values[0] = ?
        assert(values[0] > 7)
      }
      case GL_MAX_CUBE_MAP_TEXTURE_SIZE: {
        values[0] = ?
        assert(values[0] > 15)
      }
      case GL_MAX_FRAGMENT_UNIFORM_VECTORS: {
        values[0] = ?
        assert(values[0] > 15)
      }
      case GL_MAX_RENDERBUFFER_SIZE: {
        values[0] = ?
        assert(values[0] > 0)
      }
      case GL_MAX_TEXTURE_IMAGE_UNITS: {
        values[0] = ?
        assert(values[0] > 7)
      }
      case GL_MAX_TEXTURE_SIZE: {
        values[0] = ?
        assert(values[0] > 63)
      }
      case GL_MAX_VARYING_VECTORS: {
        values[0] = ?
        assert(values[0] > 7)
      }
      case GL_MAX_VERTEX_ATTRIBS: {
        values[0] = ?
        assert(values[0] > 7)
      }
      case GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS:
        values[0] = ?
      case GL_MAX_VERTEX_UNIFORM_VECTORS: {
        values[0] = ?
        assert(values[0] > 127)
      }
      case GL_MAX_VIEWPORT_DIMS: {
        values[0] = ?  /* max width */
        assert(values[0] > Rasterizing.Viewport.Width-1)
        values[1] = ?  /* max height */
        assert(values[1] > Rasterizing.Viewport.Height-1)
      }
      case GL_NUM_COMPRESSED_TEXTURE_FORMATS: {
        values[0] = ?
        assert(values[0] > -1)
      }
      case GL_NUM_SHADER_BINARY_FORMATS: {
        values[0] = ?
        assert(values[0] > -1)
      }
      case GL_PACK_ALIGNMENT:
        values[0] = PixelStorage[GL_PACK_ALIGNMENT]
      case GL_UNPACK_ALIGNMENT:
        values[0] = PixelStorage[GL_UNPACK_ALIGNMENT]
      case GL_ALPHA_BITS:
        values[0] = ?
      case GL_BLUE_BITS:
        values[0] = ?
      case GL_GREEN_BITS:
        values[0] = ?
      case GL_RED_BITS:
        values[0] = ?
      case GL_DEPTH_BITS:
        values[0] = ?
      case GL_SAMPLE_BUFFERS:
        values[0] = ?
      case GL_SAMPLES:
        values[0] = ?
      case GL_SHADER_BINARY_FORMATS:
        values = ?  /* list of length GL_NUM_SHADER_BINARY_FORMATS */
      case GL_COMPRESSED_TEXTURE_FORMATS:
        values = ?  /* list of length GL_NUM_COMPRESSED_TEXTURE_FORMATS */
      case GL_STENCIL_BITS:
        values[0] = ?
      case GL_SUBPIXEL_BITS: {
        values[0] = ?
        assert(values[0] > 3)
      }
      case GL_IMPLEMENTATION_COLOR_READ_FORMAT:
        values[0] = ?
      case GL_IMPLEMENTATION_COLOR_READ_TYPE:
        values[0] = ?
      case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
        values[0] = ?
      case GL_GPU_DISJOINT_EXT:
        values[0] = ?

      // TODO: implement the following which depend on:
      //   glStencilOp, glStencilOpSeparate, glStencilFuncSeparate.
      // GL_STENCIL_BACK_FAIL
      // GL_STENCIL_BACK_FUNC
      // GL_STENCIL_BACK_PASS_DEPTH_FAIL
      // GL_STENCIL_BACK_PASS_DEPTH_PASS
      // GL_STENCIL_BACK_REF
      // GL_STENCIL_BACK_VALUE_MASK
      // GL_STENCIL_FAIL
      // GL_STENCIL_FUNC
      // GL_STENCIL_PASS_DEPTH_FAIL
      // GL_STENCIL_PASS_DEPTH_PASS
      // GL_STENCIL_REF
      // GL_STENCIL_VALUE_MASK

      // TODO: all the values returned by glGetFloatv and glGetBooleanv can
      // be returned here with a type conversion: "_most_ f32ing-point values
      // are rounded to the nearest integer value".
    }
}

