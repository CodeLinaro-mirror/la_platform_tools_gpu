// HACK: We want to use these types in non-generated code
@internal @no_replay
class generate_types {
  u16[] u16_slice
  u32[] u32_slice
}

extern void mapMemory(any slice)
extern void unmapMemory(any slice)

extern u32 pixelSize(GLenum format, GLenum type)
extern s32 stateVariableSize(GLenum v)
macro void minRequiredVersion(u32 major, u32 minor) {  }
macro void supportsBits(GLbitfield seenBits, GLbitfield validBits) {  }
macro void requiresExtension(ExtensionId ext) {  }
macro void error(string msg) { abort }
macro void glErrorInvalidEnum(GLenum param) { abort }

macro void glErrorInvalidEnumIf(bool condition) {
  if (condition) {
    abort
  }
}

macro void glErrorInvalidOperationIf(bool condition) {
  if (condition) {
    abort
  }
}

macro void glErrorInvalidValueIf(bool condition) {
  if (condition) {
    abort
  }
}

macro u32 imageSize(u32 width, u32 height, GLenum format, GLenum type) {
  return width * height * pixelSize(format, type)
}

