// EXT_debug_marker

///http://www.khronos.org/registry/gles/extensions/EXT/EXT_debug_marker.txt
cmd void glInsertEventMarkerEXT(s32 length, char *marker) {
    if length > 0 {
        _ = as!string(marker)
    } else {
        read(marker[0:length])
    }
}

///http://www.khronos.org/registry/gles/extensions/EXT/EXT_debug_marker.txt
cmd void glPushGroupMarkerEXT(s32 length, char *marker) {
    if length > 0 {
        _ = as!string(marker)
    } else {
        read(marker[0:length])
    }
}

///http://www.khronos.org/registry/gles/extensions/EXT/EXT_debug_marker.txt
cmd void glPopGroupMarkerEXT() {}

