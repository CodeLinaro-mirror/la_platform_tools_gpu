cmd void glUniformMatrix2fv(UniformLocation location, s32 count, bool transpose, array<f32> values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glUniform.xml
    assert len(values) >= (count*4)
    program := Instances.Programs[BoundProgram]
    uniform := program.Uniforms[location]
    uniform.Value = Mat2f{
        Col0: Vec2f{X: values[0], Y: values[1]},
        Col1: Vec2f{X: values[0], Y: values[1]},
    }
    program.Uniforms[location] = uniform
}

cmd void glUniformMatrix3fv(UniformLocation location, s32 count, bool transpose, array<f32> values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glUniform.xml
    assert len(values) >= (count*9)
    program := Instances.Programs[BoundProgram]
    uniform := program.Uniforms[location]
    uniform.Value = Mat3f{
        Col0: Vec3f{X: values[0], Y: values[1], Z: values[2]},
        Col1: Vec3f{X: values[3], Y: values[4], Z: values[5]},
        Col2: Vec3f{X: values[6], Y: values[7], Z: values[8]},
    }
    program.Uniforms[location] = uniform
}

cmd void glUniformMatrix4fv(UniformLocation location, s32 count, bool transpose, array<f32> values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glUniform.xml
    assert len(values) >= (count*16)
    program := Instances.Programs[BoundProgram]
    uniform := program.Uniforms[location]
    uniform.Value = Mat4f{
        Col0: Vec4f{X: values[0],  Y: values[1],  Z: values[2],  W: values[3]},
        Col1: Vec4f{X: values[4],  Y: values[5],  Z: values[6],  W: values[7]},
        Col2: Vec4f{X: values[8],  Y: values[9],  Z: values[10], W: values[11]},
        Col3: Vec4f{X: values[12], Y: values[13], Z: values[14], W: values[15]},
    }
    program.Uniforms[location] = uniform
}

