cmd void glPixelStorei(PixelStoreParameter parameter, s32 value) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glPixelStorei.xml
    assert((value == 1) || (value == 2) || (value == 4) || (value == 8))
    PixelStorage[parameter] = value
}

cmd void glTexParameteri(TextureTarget    target,
                         TextureParameter parameter,
                         s32              value) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glTexParameter.xml
    id := TextureUnits[ActiveTextureUnit][target]
    t  := Instances.Textures[id]
    switch (parameter) {
      case GL_TEXTURE_MAG_FILTER:         t.MagFilter = value as TextureFilterMode
      case GL_TEXTURE_MIN_FILTER:         t.MinFilter = value as TextureFilterMode
      case GL_TEXTURE_WRAP_S:             t.WrapS = value as TextureWrapMode
      case GL_TEXTURE_WRAP_T:             t.WrapT = value as TextureWrapMode
      case GL_TEXTURE_MAX_ANISOTROPY_EXT: t.MaxAnisotropy = value as f32
      case GL_TEXTURE_SWIZZLE_R:          t.SwizzleR = value as TexelComponent
      case GL_TEXTURE_SWIZZLE_G:          t.SwizzleG = value as TexelComponent
      case GL_TEXTURE_SWIZZLE_B:          t.SwizzleB = value as TexelComponent
      case GL_TEXTURE_SWIZZLE_A:          t.SwizzleA = value as TexelComponent
    }
}

cmd void glTexParameterf(TextureTarget    target,
                         TextureParameter parameter,
                         f32              value) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glTexParameter.xml
    id := TextureUnits[ActiveTextureUnit][target]
    t  := Instances.Textures[id]
    switch (parameter) {
      case GL_TEXTURE_MAG_FILTER:         t.MagFilter = value as TextureFilterMode
      case GL_TEXTURE_MIN_FILTER:         t.MinFilter = value as TextureFilterMode
      case GL_TEXTURE_WRAP_S:             t.WrapS = value as TextureWrapMode
      case GL_TEXTURE_WRAP_T:             t.WrapT = value as TextureWrapMode
      case GL_TEXTURE_MAX_ANISOTROPY_EXT: t.MaxAnisotropy = value as f32
      case GL_TEXTURE_SWIZZLE_R:          t.SwizzleR = value as TexelComponent
      case GL_TEXTURE_SWIZZLE_G:          t.SwizzleG = value as TexelComponent
      case GL_TEXTURE_SWIZZLE_B:          t.SwizzleB = value as TexelComponent
      case GL_TEXTURE_SWIZZLE_A:          t.SwizzleA = value as TexelComponent
    }
}

cmd void glGetTexParameteriv(TextureTarget    target,
                             TextureParameter parameter,
                             inout array<s32>   values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glGetTexParameter.xml
    assert len(values) >= 1
    id := TextureUnits[ActiveTextureUnit][target]
    t  := Instances.Textures[id]
    values[0] = switch (parameter) {
      case GL_TEXTURE_MAG_FILTER:         t.MagFilter     as s32
      case GL_TEXTURE_MIN_FILTER:         t.MinFilter     as s32
      case GL_TEXTURE_WRAP_S:             t.WrapS         as s32
      case GL_TEXTURE_WRAP_T:             t.WrapT         as s32
      case GL_TEXTURE_MAX_ANISOTROPY_EXT: t.MaxAnisotropy as s32
      case GL_TEXTURE_SWIZZLE_R:          t.SwizzleR      as s32
      case GL_TEXTURE_SWIZZLE_G:          t.SwizzleG      as s32
      case GL_TEXTURE_SWIZZLE_B:          t.SwizzleB      as s32
      case GL_TEXTURE_SWIZZLE_A:          t.SwizzleA      as s32
    }
}

cmd void glGetTexParameterfv(TextureTarget    target,
                             TextureParameter parameter,
                             inout array<f32>   values) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glGetTexParameter.xml
    assert len(values) >= 1
    id := TextureUnits[ActiveTextureUnit][target]
    t  := Instances.Textures[id]
    values[0] = switch (parameter) {
      case GL_TEXTURE_MAG_FILTER:         t.MagFilter     as f32
      case GL_TEXTURE_MIN_FILTER:         t.MinFilter     as f32
      case GL_TEXTURE_WRAP_S:             t.WrapS         as f32
      case GL_TEXTURE_WRAP_T:             t.WrapT         as f32
      case GL_TEXTURE_MAX_ANISOTROPY_EXT: t.MaxAnisotropy as f32
      case GL_TEXTURE_SWIZZLE_R:          t.SwizzleR      as f32
      case GL_TEXTURE_SWIZZLE_G:          t.SwizzleG      as f32
      case GL_TEXTURE_SWIZZLE_B:          t.SwizzleB      as f32
      case GL_TEXTURE_SWIZZLE_A:          t.SwizzleA      as f32
    }
}

cmd void glUniform1i(UniformLocation location, s32 value) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glUniform.xml
    program := Instances.Programs[BoundProgram]
    uniform := program.Uniforms[location]
    uniform.Value = value
    program.Uniforms[location] = uniform
}

cmd void glUniform2i(UniformLocation location, s32 value0, s32 value1) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glUniform.xml
    program := Instances.Programs[BoundProgram]
    uniform := program.Uniforms[location]
    uniform.Value = Vec2i{X: value0, Y: value1}
    program.Uniforms[location] = uniform
}

