cmd void glGetShaderInfoLog(ShaderId     shader,
                            s32          buffer_length,
                            out s32      string_length_written,
                            out string   info) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glGetShaderInfoLog.xml
    assert len(info) >= buffer_length
    s := Instances.Shaders[shader]
    string_length_written = min(buffer_length, strlen(s.InfoLog))
    info = substr(s.InfoLog, 0, string_length_written)
}

cmd void glGetShaderSource(ShaderId     shader,
                           s32          buffer_length,
                           out s32      string_length_written,
                           out string   source) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glGetShaderSource.xml
    assert len(source) >= buffer_length
    s := Instances.Shaders[shader]
    // TODO: Concatenate shader.Source[] instead of using shader.Source[0].
    string_length_written = min(buffer_length, strlen(s.Source[0]))
    source = substr(s.Source[0], 0, string_length_written)
}

