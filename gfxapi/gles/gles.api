/////////////////////////////////////////////////////////////////
// Macros
/////////////////////////////////////////////////////////////////

macro u32 vertexAttribTypeSize(VertexAttribType t) {
  return switch (t) {
    case GL_BYTE:                  1
    case GL_UNSIGNED_BYTE:         1
    case GL_SHORT:                 2
    case GL_UNSIGNED_SHORT:        2
    case GL_FIXED:                 4
    case GL_FLOAT:                 4
    case GL_ARB_half_float_vertex: 2
    case GL_HALF_FLOAT_OES:        2
  }
}

macro s32 min(s32 a, s32 b) {
  return switch(a < b) {
    case true:  a
    case false: b
  }
}

