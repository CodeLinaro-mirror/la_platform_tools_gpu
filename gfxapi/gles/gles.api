}

cmd void glTexImage2D(TextureImageTarget target,
                      s32                level,
                      TexelFormat        internal_format,
                      s32                width,
                      s32                height,
                      s32                border,
                      TexelFormat        format,
                      TexelType          type,
                      TexturePointer     data) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glTexImage2D.xml
    assert(internal_format == format)
    assert(border == 0)
    switch(target) {
        case GL_TEXTURE_2D: {
            id := TextureUnits[ActiveTextureUnit][GL_TEXTURE_2D]
            t  := Instances.Textures[id]
            l  := Image {
                Width:  width,
                Height: height,
                Size:   imageSize(width, height, format, type),
                Format: format as ImageTexelFormat /* TODO: Implicit cast? */,
            }
            memcpy(l.Data, data, l.Size)
            t.Texture2D[level] = l
            t.Kind = TEXTURE2D // TODO: Warning/Error if kind has changed?
            // TODO: Warning/Error if format has changed
            t.Format = format as ImageTexelFormat // TODO: Implicit cast?
        }
        case GL_TEXTURE_CUBE_MAP_POSITIVE_X, GL_TEXTURE_CUBE_MAP_POSITIVE_Y, GL_TEXTURE_CUBE_MAP_POSITIVE_Z,
             GL_TEXTURE_CUBE_MAP_NEGATIVE_X, GL_TEXTURE_CUBE_MAP_NEGATIVE_Y, GL_TEXTURE_CUBE_MAP_NEGATIVE_Z: {
            id := TextureUnits[ActiveTextureUnit][GL_TEXTURE_CUBE_MAP]
            t  := Instances.Textures[id]
            l  := Image {
                Width:  width,
                Height: height,
                Size:   imageSize(width, height, format, type),
                Format: format as ImageTexelFormat /* TODO: Implicit cast? */,
            }
            cube := t.Cubemap[level]
            cube.Faces[target as CubeMapImageTarget] = l
            t.Cubemap[level] = cube
            t.Kind = CUBEMAP // TODO: Warning/Error if kind has changed?
            // TODO: Warning/Error if format has changed
            t.Format = format as ImageTexelFormat // TODO: Implicit cast?
        }
    }
}

cmd void glTexSubImage2D(TextureImageTarget target,
                         s32                level,
                         s32                xoffset,
                         s32                yoffset,
                         s32                width,
                         s32                height,
                         TexelFormat        format,
                         TexelType          type,
                         TexturePointer     data) {
    http://www.khronos.org/opengles/sdk/docs/man/xhtml/glTexSubImage2D.xml
    // TODO: This does not consider xoffset or yoffset and completely replaces the level.
    // FIX.
    switch(target) {
        case GL_TEXTURE_2D: {
            id := TextureUnits[ActiveTextureUnit][GL_TEXTURE_2D]
            t  := Instances.Textures[id]
            l  := Image {
                Width:  width,
                Height: height,
                Size:   imageSize(width, height, format, type),
                Format: format as ImageTexelFormat /* TODO: Implicit cast? */,
            }
            memcpy(l.Data, data, l.Size)
            t.Texture2D[level] = l
            t.Kind = TEXTURE2D // TODO: Warning/Error if kind has changed?
            // TODO: Warning/Error if format has changed
            t.Format = format as ImageTexelFormat // TODO: Implicit cast?
        }
        case GL_TEXTURE_CUBE_MAP_POSITIVE_X, GL_TEXTURE_CUBE_MAP_POSITIVE_Y, GL_TEXTURE_CUBE_MAP_POSITIVE_Z,
             GL_TEXTURE_CUBE_MAP_NEGATIVE_X, GL_TEXTURE_CUBE_MAP_NEGATIVE_Y, GL_TEXTURE_CUBE_MAP_NEGATIVE_Z: {
            id := TextureUnits[ActiveTextureUnit][GL_TEXTURE_CUBE_MAP]
            t  := Instances.Textures[id]
            l  := Image {
                Width:  width,
                Height: height,
                Size:   imageSize(width, height, format, type),
                Format: format as ImageTexelFormat /* TODO: Implicit cast? */,
            }
            memcpy(l.Data, data, l.Size)
            cube := t.Cubemap[level]
            cube.Faces[target as CubeMapImageTarget] = l
            t.Cubemap[level] = cube
            t.Kind = CUBEMAP  // TODO: Warning/Error if kind has changed?
            // TODO: Warning/Error if format has changed
            t.Format = format as ImageTexelFormat // TODO: Implicit cast?
        }
    }
}

