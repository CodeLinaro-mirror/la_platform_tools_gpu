///http://www.khronos.org/opengles/sdk/docs/man/xhtml/glEnable.xml
cmd void glEnable(GLenum capability) {
  ctx := GetContext()
  ctx.Capabilities[capability] = true
}

///http://www.khronos.org/opengles/sdk/docs/man/xhtml/glDisable.xml
cmd void glDisable(GLenum capability) {
  ctx := GetContext()
  ctx.Capabilities[capability] = false
}

///http://www.khronos.org/opengles/sdk/docs/man/xhtml/glIsEnabled.xml
cmd bool glIsEnabled(GLenum capability) {
  ctx := GetContext()
  return ctx.Capabilities[capability]
}

/////////////////////////////////////////////////////////////////
// GLES 3 APIs
/////////////////////////////////////////////////////////////////

// TODO: Consider switching to a remapped non-volatile void* if handling
//       this opaque pointer as a u64 causes issues on some platforms.
@replay_remap type u64 SyncObject

enum SyncCondition {
  GL_SYNC_GPU_COMMANDS_COMPLETE = 0x9117,
}

enum ClientWaitSyncSignal {
  GL_ALREADY_SIGNALED    = 0x911A,
  GL_TIMEOUT_EXPIRED     = 0x911B,
  GL_CONDITION_SATISFIED = 0x911C,
  GL_WAIT_FAILED         = 0x911D,
}

bitfield SyncFlags {
  GL_SYNC_FLUSH_COMMANDS_BIT = 0x00000001,
}

///http://www.khronos.org/opengles/sdk/docs/man3/html/glFenceSync.xhtml
cmd SyncObject glFenceSync(SyncCondition condition, SyncFlags syncFlags) {
  return ?
}

///http://www.khronos.org/opengles/sdk/docs/man3/html/glDeleteSync.xhtml
cmd void glDeleteSync(SyncObject sync) {
}

///http://www.khronos.org/opengles/sdk/docs/man3/html/glWaitSync.xhtml
cmd void glWaitSync(SyncObject sync, SyncFlags syncFlags, u64 timeout) {
  assert(timeout == 0xFFFFFFFFFFFFFFFF) // GL_TIMEOUT_IGNORED
}

///http://www.khronos.org/opengles/sdk/docs/man3/html/glClientWaitSync.xhtml
cmd ClientWaitSyncSignal glClientWaitSync(SyncObject sync, SyncFlags syncFlags, u64 timeout) {
