// architecture is used to describe the architecture of the device used to make
// the capture.
@synthetic @no_replay @no_mutate
cmd void architecture(u32  pointer_alignment,
                      u32  pointer_size,
                      u32  integer_size,
                      bool little_endian) {  }

// replayCreateRenderer constructs a GLES renderer for replay without making it active.
@synthetic
cmd void replayCreateRenderer(u32 id) {  }

// replayBindRenderer makes the renderer constructed with replayCreateRenderer active.
@synthetic
cmd void replayBindRenderer(u32 id) {  }

// switchThread changes the current thread to the thread with the specified identifier.
@synthetic @no_replay
cmd void switchThread(ThreadID threadID) {
  CurrentThread = threadID
}

@synthetic
cmd void contextInfo(u32     constant_count,
                     GLenum* constant_names,
                     u32*    constant_offsets,
                     u32*    constant_sizes,
                     u8*     constant_data,
                     GLsizei backbuffer_width,
                     GLsizei backbuffer_height,
                     GLenum  backbuffer_color_fmt,
                     GLenum  backbuffer_depth_fmt,
                     GLenum  backbuffer_stencil_fmt,
                     bool    reset_viewport_scissor,
                     bool    preserve_buffers_on_swap) {
  ctx := GetContext()
  const_names := constant_names[0:constant_count]
  const_offsets := constant_offsets[0:constant_count]
  const_sizes := constant_sizes[0:constant_count]
  for i in (0 .. constant_count) {
    name := const_names[i]
    offset := const_offsets[i]
    size := const_sizes[i]
    data := constant_data[offset:offset + size]
    SetConstant(ctx, name, data)
  }
  ctx.Info.PreserveBuffersOnSwap = preserve_buffers_on_swap

  backbuffer := ctx.Instances.Framebuffers[0]

  color_id := as!RenderbufferId(backbuffer.Attachments[GL_COLOR_ATTACHMENT0].Object)
  color_buffer := ctx.Instances.Renderbuffers[color_id]

  depth_id := as!RenderbufferId(backbuffer.Attachments[GL_DEPTH_ATTACHMENT].Object)
  depth_buffer := ctx.Instances.Renderbuffers[depth_id]

  stencil_id := as!RenderbufferId(backbuffer.Attachments[GL_STENCIL_ATTACHMENT].Object)
  stencil_buffer := ctx.Instances.Renderbuffers[stencil_id]

  color_buffer.Width = backbuffer_width
  color_buffer.Height = backbuffer_height
  color_buffer.Format = backbuffer_color_fmt

  depth_buffer.Width = backbuffer_width
  depth_buffer.Height = backbuffer_height
  depth_buffer.Format = backbuffer_depth_fmt

  stencil_buffer.Width = backbuffer_width
  stencil_buffer.Height = backbuffer_height
  stencil_buffer.Format = backbuffer_stencil_fmt

  if reset_viewport_scissor {
    ctx.Rasterizing.Scissor.Width = backbuffer_width
    ctx.Rasterizing.Scissor.Height = backbuffer_height
    ctx.Rasterizing.Viewport.Width = backbuffer_width
    ctx.Rasterizing.Viewport.Height = backbuffer_height
  }

  // Initialize state which depends on constants,
  // but do not overwrite any existing state.

  for i in (0 .. ctx.Constants.MaxVertexAttribs) {
    if !(i in ctx.VertexAttributes) {
      v := make!Vec4f(1)
      v[0] = Vec4f(0.0, 0.0, 0.0, 1.0)
      ctx.VertexAttributes[i] = VertexAttributeValue(Value: as!u8[](v))
    }
  }

  for i in (0 .. ctx.Constants.MaxCombinedTextureImageUnits) {
    name := GL_TEXTURE0 + as!GLenum(i)
    if !(name in ctx.TextureUnits) {
      ctx.TextureUnits[name] = new!TextureUnit()
    }
  }
}

@synthetic
cmd void startTimer(u8 index) {  }

@synthetic
cmd u64 stopTimer(u8 index) { return ? }  // Time returned in nanoseconds

@synthetic
cmd void flushPostBuffer() {  }
