{{/*
-------------------------------------------------------------------------------
  Emits the static variable name holding the ID of the given function.
-------------------------------------------------------------------------------
*/}}
{{define "ID"}}
  {{AssertType $ "Function"}}

  {{SplitPascalCase $.Name | Upper | JoinWith "_"}}_ID
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the function pointer parameter for the spy Call function.
-------------------------------------------------------------------------------
*/}}
{{define "FunctionPointer"}}
  {{AssertType $ "Function"}}

  {{Macro "C++.ReturnType" $}} (__stdcall *F)({{Macro "C++.CallParameterTypes" $}})
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits a single C++ method definition for the given atom.
-------------------------------------------------------------------------------
*/}}
{{define "MethodDefinitions"}}
  {{AssertType $ "Function"}}

  {{$cp := Macro "C++.CallParameters" $}}
  inline {{Macro "C++.ReturnType" $}} {{$.Name}}({{Macro "FunctionPointer" $}}{{if $cp}}, {{$cp}}{{end}});
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the inline method body for the given atom.
-------------------------------------------------------------------------------
*/}}
{{define "MethodImplementation"}}
  {{AssertType $ "Function"}}

  {{$cp  := Macro "C++.CallParameters" $}}
  {{$ret := not (IsVoid $.Return.Type)}}
  inline {{Macro "C++.ReturnType" $}} Spy::{{$.Name}}({{Macro "FunctionPointer" $}}{{if $cp}}, {{$cp}}{{end}}) {
    {{$pre_obs  := Macro "PreCallObservations"  $}}
    {{$post_obs := Macro "PostCallObservations" $}}

    {{if $pre_obs}}{{$pre_obs}}¶{{end}}

    {{if $ret}}{{Macro "C++.ReturnType" $}} result = F({{Macro "C++.CallArguments" $}});
    {{else}}F({{Macro "C++.CallArguments" $}});
    {{end}}
    mState.{{$.Name}}({{Macro "C++.ReadList" $.FullParameters}});
¶
    {{/*{{if $post_obs}}{{$post_obs}}¶{{end}}*/}}

    mEncoder->U16({{Global "HACK_FUNCTION_INDEX_HACK"}}); // Type ID -- TODO: mEncoder->Id({{Macro "ID" $}});
    mEncoder->U32(mContextId);
    {{range $i, $p := $.FullParameters}}
      {{$name := Macro "C++.ReadParameter" $p}}
      {{Macro "Encode" "Parameter" $p "Type" (TypeOf $p) "Name" $name}};
    {{end}}

    {{if $ret}}¶
      return result;
    {{end}}
  }
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the C++ pre-call observations.
-------------------------------------------------------------------------------
*/}}
{{define "PreCallObservations"}}
  {{AssertType $ "Function"}}

  {{range $i, $p := $.FullParameters}}
    {{if $p.Input}}
      {{$ty := TypeOf $p}}
      {{if IsPointerType $ty}}
        observe({{Macro "C++.ReadParameter" $p}}, {{Macro "ArrayParamCount" $p}}, PRE_OBSERVE);
      {{end}}
    {{end}}
  {{end}}
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the C++ post-call observations.
-------------------------------------------------------------------------------
*/}}
{{define "PostCallObservations"}}
  {{AssertType $ "Function"}}

  {{range $i, $p := $.FullParameters}}
    {{if $p.Output}}
      {{$ty := TypeOf $p}}
      {{if IsPointerType $ty}}
        observe({{Macro "C++.ReadParameter" $p}}, {{Macro "ArrayParamCount" $p}}, POST_OBSERVE);
      {{end}}
    {{end}}
  {{end}}
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the C++ expression for the number of elements in the provided array
  parameter.
-------------------------------------------------------------------------------
*/}}
{{define "ArrayParamCount"}}
  {{AssertType $ "Parameter"}}

  {{if eq $.Function.Return.Name $.Name}}
    {{$cnt_expr := GetAnnotation $.Function "ReturnSize"}}
    {{if not $cnt_expr}}{{Error "Unable to determine array parameter count for: %s.%s" $.Function.Name $.Name}}{{end}}
    {{Macro "C++.Read" (index $cnt_expr.Arguments 0)}}
  {{else}}
    {{$cnt_expr := GetArrayParamCount $}}
    {{if not $cnt_expr}}{{Error "Unable to determine array parameter count for: %s.%s" $.Function.Name $.Name}}{{end}}
    {{Macro "C++.Read" $cnt_expr}}
  {{end}}
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the C++ encode logic for the specified parameter.
-------------------------------------------------------------------------------
*/}}
{{define "Encode"}}
  {{AssertType $.Type      "Type"}}
  {{AssertType $.Name      "string"}}
  {{AssertType $.Parameter "Parameter"}}

  {{     if IsPseudonym   $.Type}}{{Macro "Encode" "Type" $.Type.To "Name" $.Name "Parameter" $.Parameter}}
  {{else if IsBool        $.Type}}mEncoder->Bool({{$.Name}})
  {{else if IsInt         $.Type}}mEncoder->Int({{$.Name}})
  {{else if IsUint        $.Type}}mEncoder->Uint({{$.Name}})
  {{else if IsU8          $.Type}}mEncoder->U8({{$.Name}})
  {{else if IsS8          $.Type}}mEncoder->S8({{$.Name}})
  {{else if IsU16         $.Type}}mEncoder->U16({{$.Name}})
  {{else if IsS16         $.Type}}mEncoder->S16({{$.Name}})
  {{else if IsF32         $.Type}}mEncoder->F32({{$.Name}})
  {{else if IsU32         $.Type}}mEncoder->U32({{$.Name}})
  {{else if IsS32         $.Type}}mEncoder->S32({{$.Name}})
  {{else if IsF64         $.Type}}mEncoder->F64({{$.Name}})
  {{else if IsU64         $.Type}}mEncoder->U64({{$.Name}})
  {{else if IsS64         $.Type}}mEncoder->S64({{$.Name}})
  {{else if IsPointerType $.Type}}mEncoder->U64(reinterpret_cast<uint64_t>({{$.Name}}))
  {{else if IsString      $.Type}}mEncoder->String({{$.Name}})
  {{else if IsEnum        $.Type}}mEncoder->U32(static_cast<uint32_t>({{$.Name}}))
  {{else if IsArray       $.Type}}mEncoder->U64(reinterpret_cast<uint64_t>({{$.Name}}))
  {{else}}{{Error "Encode passed unsupported type: %s" $.Type.Name}}
  {{end}}
{{end}}

