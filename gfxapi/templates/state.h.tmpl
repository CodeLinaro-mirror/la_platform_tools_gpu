{{/*
-------------------------------------------------------------------------------
  Emits the comma-separated list of type-name paired parameters for given
  function, including the return value. All outputs are treated as inputs.
-------------------------------------------------------------------------------
*/}}
{{define "Parameters"}}
  {{AssertType $ "Function"}}

  {{range $i, $p := $.FullParameters}}
    {{if $i}}, {{end}}{{Macro "C++.Type" $p}} {{$p.Name}}§
  {{end}}
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the logic for all the statements in the given block.
-------------------------------------------------------------------------------
*/}}
{{define "Block"}}
  {{range $s := $.Statements}}
    {{$v := Macro "Statement" $s}}
    {{$v}}
  {{end}}
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the logic to execute the given statement without mutating outputs.
-------------------------------------------------------------------------------
*/}}
{{define "Statement"}}
  {{     if IsAssign $}}{{Macro "Assign" $}}
  {{else if IsReturn $}}return;
  {{else if IsBranch $}}if ({{Macro "C++.Read" $.Condition}}) {
    {{Macro "C++.Block" $.True}}
    {{if len $.False.Statements}}
      } else {
        {{Macro "C++.Block" $.False}}
    {{end}}
    }
  {{else if IsSwitch $}}
    switch ({{Macro "C++.Read" $.Value}}) {
      {{range $i, $c := $.Cases}}
        {{range $j, $cond := $c.Conditions}}
          case {{Macro "C++.Read" $cond}}:{{if HasMore $j $c.Conditions}} // fall-through...{{else}} {{"{"}}{{end}}
        {{end}}
          {{Macro "C++.Block" $c.Block}}
          break;
        }
      {{end}}
    }
  {{else}}{{Macro "C++.Statement" $}}
  {{end}}
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the logic to perform an assign statement if the LHS is not an output.
-------------------------------------------------------------------------------
*/}}
{{define "Assign"}}
  {{AssertType $ "Assign"}}

  {{if not ((IsParameter $.LHS) $.LHS.Output)}}
    {{Macro "C++.Read" $.LHS}} = {{Macro "C++.Read" $.RHS}};
  {{end}}
{{end}}

