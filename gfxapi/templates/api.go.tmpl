{{define "Pseudonym"}}
  {{AssertType $ "Pseudonym"}}

  {{$u := $ | Underlying}}
  {{     if IsPointer  $u}}{{Template "Pointer" $}}
  {{else if IsSlice    $u}}{{Template "Slice"   $}}
  {{else if IsVoid     $u}}
  {{else                 }}type {{$.Name}} {{Template "Go.Type" $.To}}
  {{end}}
{{end}}


{{/*
