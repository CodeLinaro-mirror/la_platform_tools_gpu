{{Global "C++.EnumTypeOverride" "uint32_t"}}

{{Include "cpp_common.tmpl"}}
{{$filename := print (Global "API") "_imports.h" }}
{{$ | Macro "imports.h" | Format (Global "clang-format") | Write $filename}}

{{/*
-------------------------------------------------------------------------------
  Entry point.
-------------------------------------------------------------------------------
*/}}
{{define "imports.h"}}
  {{Macro "C++.AOSP.Copyright"}}
  {{$classname := print (Title (Global "API")) "Imports"}}
  {{$guard := print "GAPII_" (Upper (Global "API")) "_IMPORTS_H"}}
¶
  #ifndef {{$guard}}
  #define {{$guard}}
¶
  #include "{{Global "API"}}_types.h"
¶
  namespace gapii {
¶
  struct {{$classname}} {
    void Resolve();
¶
    {{range $c := AllCommands $}}
      {{if not (GetAnnotation $c "synthetic")}}
        {{template "TypedefFunctionPtr" $c}}
      {{end}}
    {{end}}
¶
    {{range $c := AllCommands $}}
      {{if not (GetAnnotation $c "synthetic")}}
        {{template "FunctionPtrDecl" $c}}
      {{end}}
    {{end}}
¶
    };
  } // namespace gapii
¶
  #endif // {{$guard}}
¶
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the typedef function-pointer name for a given command.
-------------------------------------------------------------------------------
*/}}
{{define "FunctionPtrType"}}
  {{AssertType $ "Function"}}

  PFN{{Macro "C++.MethodName" $ | Upper}}
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the C++ function-pointer typedef for a given command.
-------------------------------------------------------------------------------
*/}}
{{define "TypedefFunctionPtr"}}
  {{AssertType $ "Function"}}

  typedef {{Macro "C++.ReturnType" $}} (__stdcall *{{Macro "FunctionPtrType" $}})({{Macro "C++.CallParameters" $}});
{{end}}


{{/*
-------------------------------------------------------------------------------
  Emits the C++ function-pointer variable extern for a given command.
-------------------------------------------------------------------------------
*/}}
{{define "FunctionPtrDecl"}}
  {{AssertType $ "Function"}}

  {{Macro "FunctionPtrType" $}} {{Macro "C++.MethodName" $}};
{{end}}
