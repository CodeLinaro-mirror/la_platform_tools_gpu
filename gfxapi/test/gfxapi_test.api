alias void[] pointer

@replay_remap type u32 remapped

cmd void cmd_void() {}

////////////////////////////////////////////////////////////////
// Commands with a single input argument
////////////////////////////////////////////////////////////////
cmd void cmd_void_u8(u8 a)         {}
cmd void cmd_void_s8(s8 a)         {}
cmd void cmd_void_u16(u16 a)       {}
cmd void cmd_void_s16(s16 a)       {}
cmd void cmd_void_f32(f32 a)       {}
cmd void cmd_void_u32(u32 a)       {}
cmd void cmd_void_s32(s32 a)       {}
cmd void cmd_void_f64(f64 a)       {}
cmd void cmd_void_u64(u64 a)       {}
cmd void cmd_void_s64(s64 a)       {}
cmd void cmd_void_bool(bool a)     {}
cmd void cmd_void_string(string a) {}

////////////////////////////////////////////////////////////////
// Commands with more than one input
////////////////////////////////////////////////////////////////
cmd void cmd_void_3_strings(string a, string b, string c) {}

////////////////////////////////////////////////////////////////
// Array inputs
////////////////////////////////////////////////////////////////
cmd void cmd_void_3_arrays(array<s8> a, array<string> b, array<bool> c) {}

////////////////////////////////////////////////////////////////
// Array of strings as input
////////////////////////////////////////////////////////////////
cmd void cmd_void_array_of_strings(array<string> a) {}

////////////////////////////////////////////////////////////////
// Commands with a return value
////////////////////////////////////////////////////////////////
cmd u8   cmd_u8()   { return 0 }
cmd s8   cmd_s8()   { return 0 }
cmd u16  cmd_u16()  { return 0 }
cmd s16  cmd_s16()  { return 0 }
cmd f32  cmd_f32()  { return 0 }
cmd u32  cmd_u32()  { return 0 }
cmd s32  cmd_s32()  { return 0 }
cmd f64  cmd_f64()  { return 0 }
cmd u64  cmd_u64()  { return 0 }
cmd s64  cmd_s64()  { return 0 }
cmd bool cmd_bool() { return false }

@ReturnSize(10)
cmd string     cmd_string()         { return "" }
@ReturnSize(10)
cmd array<f32> cmd_array_of_float() { return ? }
@ReturnSize(10)
cmd pointer    cmd_pointer()        { return ? }

////////////////////////////////////////////////////////////////
// Commands with a single output argument
////////////////////////////////////////////////////////////////
cmd void cmd_void_out_u8(out u8 a)         {}
cmd void cmd_void_out_s8(out s8 a)         {}
cmd void cmd_void_out_u16(out u16 a)       {}
cmd void cmd_void_out_s16(out s16 a)       {}
cmd void cmd_void_out_f32(out f32 a)       {}
cmd void cmd_void_out_u32(out u32 a)       {}
cmd void cmd_void_out_s32(out s32 a)       {}
cmd void cmd_void_out_f64(out f64 a)       {}
cmd void cmd_void_out_u64(out u64 a)       {}
cmd void cmd_void_out_s64(out s64 a)       {}
cmd void cmd_void_out_bool(out bool a)     {}

cmd void cmd_void_out_string(out string a)             { assert len(a) >= 10 }
cmd void cmd_void_out_fixed_size_buffer(out pointer a) { assert len(a) >= 10 }

////////////////////////////////////////////////////////////////
// Commands with more than one output
////////////////////////////////////////////////////////////////
cmd void cmd_void_out_3_strings(out string a, out string b, out string c) {
	assert len(a) >= 0x0f
	assert len(b) >= 0x1f
	assert len(c) >= 0x2f
}

////////////////////////////////////////////////////////////////
// Commands with remapped input arguments
////////////////////////////////////////////////////////////////
cmd void cmd_void_3_remapped(remapped a, remapped b, remapped c) {}

////////////////////////////////////////////////////////////////
// Commands with remapped output arguments
////////////////////////////////////////////////////////////////
cmd void cmd_void_out_3_remapped(out remapped a, out remapped b, out remapped c) {}

cmd void cmd_void_out_array_of_remapped(out array<remapped> a) { assert len(a) >= 5 }
