extern u32          Add(u32 a, u32 b)
extern string       EnumToString(Enum e)
extern Struct       GetStruct()
extern void         SetStruct(Struct s)
extern ResourceId   GetResource()
extern void         UseResource(ResourceId r)
extern Resource     ResolveResource(ResourceId r)
extern ListNode*    GetSingleListNode()
extern ListNode*    GetListNodeChain()
extern ListNode*[]  GetListNodeChainArray()

@handle type string ResourceId
class Resource {
  u32    Int
  f32    Float
  string String
}

enum Enum {
  One   = 1,
  Two   = 2,
  Three = 3,
}

class Struct {
  string String
  u32    U32
  Enum   Enum
}

class ListNode {
  string Name
  ListNode* Next
}

@Interface
class Base {
  string Name
}
